using System;
using System.Data.SqlClient;
using System.Threading.Tasks;
using System.Windows.Forms;
using Excel = Microsoft.Office.Interop.Excel;

namespace Hotel
{
    public partial class Service : Form
    {
        string connectionString = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachdbFilename=|DataDirectory|Database1.mdf; Integrated Security=True";

        private int NewIndex()
        {
            string querty = "SELECT COUNT(*) FROM Заказ_услуги";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(querty, connection))
                {
                    return Convert.ToInt32(command.ExecuteScalar()) + 1;
                }
            }
        }

        private void ShowData()
        {
            string querty;
            dataGridView1.Rows.Clear();
            querty = "SELECT зу.Заказ_id, зу.Бронь, г.ФИО, у.Название_услуги, зу.Дата_Заказа, зу.цена, зу.Статус_заказа FROM Заказ_услуги зу " +
                "JOIN Услуги у ON у.Услуга_ID = зу.Услуга " +
                "JOIN Бронирование б ON зу.Бронь = б.Бронь_ID " +
                "JOIN Гости г ON б.Гость = г.гость_ID";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(querty, connection))
                {
                    using (SqlDataReader reader = command.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            var date = Convert.ToDateTime(reader[4]);

                            dataGridView1.Rows.Add(
                                reader[0].ToString(),
                                reader[1].ToString(),
                                reader[2].ToString(), 
                                reader[3].ToString(),
                                date.ToString("yyyy-MM-dd"),
                                reader[5].ToString(),
                                reader[6].ToString());
                        }
                    }
                }
                connection.Close();
            }
        }

        public Service()
        {
            InitializeComponent();
            dataGridView1.Columns.Add("Код", "Код");
            dataGridView1.Columns.Add("Бронь", "Бронь");
            dataGridView1.Columns.Add("Гость", "Гость");
            dataGridView1.Columns.Add("Услуга", "Услуга");
            dataGridView1.Columns.Add("Дата заказа", "Дата заказа");
            dataGridView1.Columns.Add("Цена", "Цена");
            dataGridView1.Columns.Add("Статус услуги", "Статус услуги");
            ShowData();

            string querty;

            querty = "SELECT Бронь_ID, Дата_бронирования, Цена FROM Бронирование";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(querty, connection))
                {
                    using (SqlDataReader reader = command.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            var date = Convert.ToDateTime(reader[1]).ToString("yyyy-MM-dd");
                            comboBox1.Items.Add(reader[0] + " Бронь от " + date + " Цена: " + reader[2]);
                        }
                    }
                }
            }

            querty = "SELECT * FROM Услуги";
            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(querty, connection))
                {
                    using (SqlDataReader reader = command.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            comboBox2.Items.Add(reader[0] + " " + reader[1]);
                        }
                    }
                }
            }

            comboBox3.Items.Add("Выполнена");
            comboBox3.Items.Add("Не выполнена");
            comboBox3.SelectedIndex = 0;
        }

        private void button1_Click(object sender, EventArgs e)
        {
            if (comboBox3.Text != ""
              && textBox4.Text != "")
            {
                string query = "INSERT INTO Заказ_услуги (Заказ_Id, Бронь, Услуга, Дата_Заказа, цена, Статус_заказа) " +
                    "VALUES (@Заказ_Id, @Бронь, @Услуга, @Дата_Заказа, @цена, @Статус_заказа);";
                
                using (SqlConnection connection = new SqlConnection(connectionString))
                {
                    connection.Open();
                    using (SqlCommand command = new SqlCommand(query, connection))
                    {
                        command.Parameters.AddWithValue("@Заказ_Id", NewIndex());
                        command.Parameters.AddWithValue("@Бронь", comboBox1.Text.Split(' ')[0]);
                        command.Parameters.AddWithValue("@Услуга", comboBox2.Text.Split(' ')[0]);
                        command.Parameters.AddWithValue("@Дата_Заказа", dateTimePicker1.Value);
                        command.Parameters.AddWithValue("@цена", textBox4.Text);
                        command.Parameters.AddWithValue("@Статус_заказа", comboBox3.Text);

                        try
                        {
                            if (command.ExecuteNonQuery() == 0)
                            {
                                MessageBox.Show("Неверно введённые данные!");
                            }
                            else
                            {
                                MessageBox.Show("Заказ зарегистрирован!");
                            }

                        }
                        catch (Exception ex)
                        {
                            MessageBox.Show($"{ex.Message} | Неверно введённые данные!");
                        }
                    }
                    connection.Close();
                }
                ShowData();
            }
            else
            {
                MessageBox.Show("Введите данные!");
            }
        }

        private void toExcelButton_Click(object sender, EventArgs e)
        {
            string query = @"
            SELECT
                б.Бронь_ID AS Бронь,
                г.ФИО AS Гость,
                у.Название_услуги AS Услуга,
                зу.цена AS Цена,
                зу.Дата_Заказа AS Дата,
                зу.Статус_заказа AS Статус
            FROM Заказ_услуги зу
            JOIN Бронирование б ON зу.Бронь = б.Бронь_ID
            JOIN Гости г ON б.Гость = г.гость_ID
            JOIN Услуги у ON зу.Услуга = у.Услуга_ID";

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(query, connection))
                using (SqlDataReader reader = command.ExecuteReader())
                {
                    Excel.Application excelApp = new Excel.Application();
                    Excel.Workbook workbook = excelApp.Workbooks.Add();
                    Excel.Worksheet worksheet = workbook.ActiveSheet;

                    int col = 1;
                    worksheet.Cells[1, col++] = "Бронь";
                    worksheet.Cells[1, col++] = "Гость";
                    worksheet.Cells[1, col++] = "Услуга";
                    worksheet.Cells[1, col++] = "Цена";
                    worksheet.Cells[1, col++] = "Дата заказа";
                    worksheet.Cells[1, col++] = "Статус";

                    int row = 2;
                    while (reader.Read())
                    {
                        col = 1;
                        worksheet.Cells[row, col++] = reader["Бронь"].ToString();
                        worksheet.Cells[row, col++] = reader["Гость"].ToString();
                        worksheet.Cells[row, col++] = reader["Услуга"].ToString();
                        worksheet.Cells[row, col++] = reader["Цена"].ToString();
                        worksheet.Cells[row, col++] = Convert.ToDateTime(reader["Дата"]).ToShortDateString();
                        worksheet.Cells[row, col++] = reader["Статус"].ToString();
                        row++;
                    }

                    int lastRow = row - 1;
                    Excel.Range dataRange = worksheet.Range[worksheet.Cells[1, 1], worksheet.Cells[lastRow, 6]];
                    dataRange.Borders.LineStyle = Excel.XlLineStyle.xlContinuous;
                    dataRange.Borders.Weight = Excel.XlBorderWeight.xlThin;

                    Excel.Range headerRange = worksheet.Range[worksheet.Cells[1, 1], worksheet.Cells[1, 6]];
                    headerRange.Interior.Color = System.Drawing.ColorTranslator.ToOle(System.Drawing.Color.DarkSeaGreen);

                    worksheet.Columns.AutoFit();
                    excelApp.Visible = true;

                    reader.Close();
                }
            }
        }

        private void comboBox2_SelectedIndexChanged(object sender, EventArgs e)
        {
            string querty = "SELECT Цена FROM Услуги WHERE Услуга_ID = @serviceId";
            char serviceId = comboBox2.SelectedItem.ToString()[0];

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                connection.Open();
                using (SqlCommand command = new SqlCommand(querty, connection))
                {
                    command.Parameters.AddWithValue("@serviceId", serviceId);

                    int price = Convert.ToInt32(command.ExecuteScalar());

                    textBox4.Text = price.ToString();
                }
            }
        }

        private void toExcelButton_2_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(comboBox1.Text) ||
                string.IsNullOrWhiteSpace(comboBox2.Text) ||
                string.IsNullOrWhiteSpace(comboBox3.Text) ||
                string.IsNullOrWhiteSpace(textBox4.Text))
            {
                MessageBox.Show("Заполните все поля!");
                return;
            }

            try
            {
                string guestName = "";
                int bookingId = Convert.ToInt32(comboBox1.Text.Split(' ')[0]);

                string guestQuery = @"
                    SELECT г.ФИО 
                    FROM Бронирование б
                    JOIN Гости г ON б.Гость = г.гость_ID
                    WHERE б.Бронь_ID = @BookingId";

                using (SqlConnection connection = new SqlConnection(connectionString))
                {
                    connection.Open();
                    using (SqlCommand command = new SqlCommand(guestQuery, connection))
                    {
                        command.Parameters.AddWithValue("@BookingId", bookingId);
                        object result = command.ExecuteScalar();
                        if (result != null)
                            guestName = result.ToString();
                    }
                }

                Excel.Application excelApp = new Excel.Application();
                Excel.Workbook workbook = excelApp.Workbooks.Add();
                Excel.Worksheet worksheet = workbook.ActiveSheet;

                string[] headers = { "Бронь", "Гость", "Услуга", "Дата заказа", "Цена", "Статус услуги" };
                for (int i = 0; i < headers.Length; i++)
                    worksheet.Cells[1, i + 1] = headers[i];

                worksheet.Cells[2, 1] = comboBox1.Text.Split(' ')[0];
                worksheet.Cells[2, 2] = guestName;
                worksheet.Cells[2, 3] = comboBox2.Text.Substring(1);
                worksheet.Cells[2, 4] = dateTimePicker1.Value.ToShortDateString();
                worksheet.Cells[2, 5] = textBox4.Text;
                worksheet.Cells[2, 6] = comboBox3.Text;

                Excel.Range dataRange = worksheet.Range[worksheet.Cells[1, 1], worksheet.Cells[2, 6]];
                dataRange.Borders.LineStyle = Excel.XlLineStyle.xlContinuous;
                worksheet.Range[worksheet.Cells[1, 1], worksheet.Cells[1, 6]].Interior.Color =
                    System.Drawing.ColorTranslator.ToOle(System.Drawing.Color.DarkSeaGreen);

                worksheet.Columns.AutoFit();
                excelApp.Visible = true;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка: {ex.Message}");
            }
        }

        private void dataGridView1_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            try
            {
                var orderId = Convert.ToInt32(dataGridView1.Rows[e.RowIndex].Cells["Код"].Value);
                var serviceTitle = dataGridView1.Rows[e.RowIndex].Cells["Услуга"].Value;

                if (string.IsNullOrEmpty(serviceTitle.ToString())) return;

                string querty = "UPDATE Заказ_услуги SET Статус_заказа = N'Выполнена' WHERE Заказ_id = @orderId";

                using (SqlConnection connection = new SqlConnection(connectionString))
                {
                    connection.Open();
                    using (SqlCommand command = new SqlCommand(querty, connection))
                    {
                        command.Parameters.AddWithValue("@orderId", orderId);

                        command.ExecuteNonQuery();

                        ShowData();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка: {ex.Message}");
            }
        }
    }
}
