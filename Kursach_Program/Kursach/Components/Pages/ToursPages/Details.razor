@page "/tours/details"
@using Microsoft.EntityFrameworkCore
@using Kursach.Models
@inject IDbContextFactory<Kursach.Data.KursachContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Детали</PageTitle>

<h1>Детали</h1>

<div>
    <h2>Туры</h2>
    <hr />
    @if (tours is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@tours.Name</dd>
            <dt class="col-sm-2">Направление</dt>
            <dd class="col-sm-10">@tours.Destination</dd>
            <dt class="col-sm-2">Дата начала</dt>
            <dd class="col-sm-10">@tours.StartDate</dd>
            <dt class="col-sm-2">Дата окончания</dt>
            <dd class="col-sm-10">@tours.EndDate</dd>
            <dt class="col-sm-2">Цена</dt>
            <dd class="col-sm-10">@tours.Price</dd>
            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@tours.Description</dd>
            <dt class="col-sm-2">Доступные места</dt>
            <dd class="col-sm-10">@tours.AvailableSeats</dd>
        </dl>
        <div>
            <a href="@($"/tours/edit?id={tours.Id}")">Редактировать</a> |
            <a href="@($"/tours")">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Tours? tours;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tours = await context.Tours.FirstOrDefaultAsync(m => m.Id == Id);

        if (tours is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
