@page "/clients/delete"
@using Microsoft.EntityFrameworkCore
@using Kursach.Models
@inject IDbContextFactory<Kursach.Data.KursachContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удалить</PageTitle>

<h1>Удалить</h1>

<p>Вы уверены, что хотите удалить этого клиента?</p>
<div>
    <h2>Клиенты</h2>
    <hr />
    @if (clients is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Имя</dt>
            <dd class="col-sm-10">@clients.FirstName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Фамилия</dt>
            <dd class="col-sm-10">@clients.LastName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Телефон</dt>
            <dd class="col-sm-10">@clients.Phone</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Электронная почта</dt>
            <dd class="col-sm-10">@clients.Email</dd>
        </dl>
        <EditForm method="post" Model="clients" OnValidSubmit="DeleteClients" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(clients is null)">Удалить</button> |
            <a href="/clients">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Clients? clients;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        clients = await context.Clients.FirstOrDefaultAsync(m => m.Id == Id);

        if (clients is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteClients()
    {
        using var context = DbFactory.CreateDbContext();
        context.Clients.Remove(clients!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/clients");
    }
}
