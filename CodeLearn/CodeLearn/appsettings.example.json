{
  "_comment": "ШАБЛОН. Скопируй в appsettings.json и подставь свои значения. appsettings.json в git НЕ коммитится (секреты).",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=CodeLearn;Username=postgres;Password=ВАШ_ПАРОЛЬ;Ssl Mode=Prefer;Trust Server Certificate=true"
  },
  "Authentication": {
    "Google": {
      "ClientId": "ВАШ_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "ВАШ_GOOGLE_CLIENT_SECRET"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Builder": {
    "Enabled": "true"
  },
  "Ai": {
    "Provider": "groq",
    "ApiKey": "ВАШ_AI_API_KEY",
    "Model": "meta-llama/llama-4-scout-17b-16e-instruct",
    "DailyMessageLimit": 20,
    "MaxTokens": 768,
    "HistoryMessages": 8
  },
  "Platform": {
    "SiteName": "CodeLearn",
    "RegistrationOpen": true,
    "AllowComments": true,
    "AllowAiChat": true,
    "CommentMaxLength": 1000,
    "HintThreshold": 3,
    "ChatPollIntervalSec": 3,
    "CommentsPerPage": 100,
    "ProgressionLock": true
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "User": "ваша_почта@gmail.com",
    "AppPassword": "ВАШ_APP_PASSWORD",
    "From": "CodeLearn <ваша_почта@gmail.com>"
  }
