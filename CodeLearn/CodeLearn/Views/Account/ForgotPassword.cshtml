@model CodeLearn.Models.ForgotPasswordViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/auth/auth.css" asp-append-version="true" />
}

@section FullPage {
<div class="auth-page">
<div id="stars"></div>

    <div class="auth-logo">CodeLearn</div>
    <div class="auth-tagline">Сброс пароля</div>

    <div class="auth-card">
        <div class="auth-card-title">Забыли пароль?</div>

        @if (ViewBag.Sent == true)
        {
            <div class="auth-validation-summary" style="color:#6fe09a">
                Если аккаунт с таким email существует — мы отправили ссылку для сброса. Проверь почту.
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <input class="auth-field" asp-for="Email" placeholder="email" type="email" autocomplete="email" />
                <span class="auth-validation" asp-validation-for="Email"></span>

                <div class="auth-validation auth-validation-summary" asp-validation-summary="ModelOnly"></div>

                <button type="submit" class="auth-btn">Отправить ссылку</button>
            </form>
        }

        <div class="auth-footer">
            <a asp-action="Login">← Назад ко входу</a>
        </div>
    </div>
</div>

<script src="~/js/main/effects/starPerlin.js" asp-append-version="true"></script>
}
