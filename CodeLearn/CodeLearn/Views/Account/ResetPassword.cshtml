@model CodeLearn.Models.ResetPasswordViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/auth/auth.css" asp-append-version="true" />
}

@section FullPage {
<div class="auth-page">
<div id="stars"></div>

    <div class="auth-logo">CodeLearn</div>
    <div class="auth-tagline">Новый пароль</div>

    <div class="auth-card">
        <div class="auth-card-title">Задать новый пароль</div>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <input class="auth-field" asp-for="Password" placeholder="новый пароль" type="password" autocomplete="new-password" />
            <span class="auth-validation" asp-validation-for="Password"></span>

            <input class="auth-field" asp-for="ConfirmPassword" placeholder="повтори пароль" type="password" autocomplete="new-password" />
            <span class="auth-validation" asp-validation-for="ConfirmPassword"></span>

            <div class="auth-validation auth-validation-summary" asp-validation-summary="ModelOnly"></div>

            <button type="submit" class="auth-btn">Сохранить</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login">← Ко входу</a>
        </div>
    </div>
</div>

<script src="~/js/main/effects/starPerlin.js" asp-append-version="true"></script>
}
