@model CodeLearn.Models.LoginViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/auth/auth.css" asp-append-version="true" />
}

@section FullPage {
<div class="auth-page">
<div id="stars"></div>

    <!-- Пиксельная сетка-фон (в CSS через ::before) -->

    <!-- Геометрические фигуры -->
    <div class="geo-shapes">
        <svg class="geo geo-1" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="180" height="180" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <rect x="30" y="30" width="140" height="140" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
        </svg>
        <svg class="geo geo-3" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <polygon points="100,8 192,190 8,190" fill="none" stroke="rgba(255,255,255,0.09)" stroke-width="1"/>
        </svg>
        <svg class="geo geo-5" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <polygon points="100,6 194,100 100,194 6,100" fill="none" stroke="rgba(255,255,255,0.09)" stroke-width="1"/>
        </svg>
        <svg class="geo geo-center" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <polygon points="100,4 196,52 196,148 100,196 4,148 4,52"
                     fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.8"/>
            <polygon points="100,20 180,60 180,140 100,180 20,140 20,60"
                     fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="0.8"/>
            <rect x="40" y="40" width="120" height="120" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.8"/>
        </svg>
        <svg class="geo geo-7" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="20" width="260" height="260" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1.5" stroke-dasharray="8 6"/>
        </svg>
    </div>

    <div class="auth-logo">CodeLearn</div>
    <div class="auth-tagline">Изучай и проходи</div>

    <div class="auth-card">
        <div class="auth-card-title">Войти</div>

        @if (TempData["ResetOk"] != null)
        {
            <div class="auth-validation-summary" style="color:#6fe09a">@TempData["ResetOk"]</div>
        }

        <form asp-action="Login" method="post">
            <input class="auth-field" asp-for="Email" placeholder="email" type="email" autocomplete="email" />
            <span class="auth-validation" asp-validation-for="Email"></span>

            <input class="auth-field" asp-for="Password" placeholder="пароль" type="password" autocomplete="current-password" />
            <span class="auth-validation" asp-validation-for="Password"></span>

            <div class="auth-validation auth-validation-summary" asp-validation-summary="ModelOnly"></div>

            <button type="submit" class="auth-btn">Войти</button>
        </form>

        <div class="auth-footer" style="margin-top:8px">
            <a asp-action="ForgotPassword">Забыли пароль?</a>
        </div>

        <div class="auth-divider">— или —</div>

        <a asp-action="GoogleLogin" class="auth-btn-google">
            <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.2l6.7-6.7C35.9 2.5 30.3 0 24 0 14.8 0 6.9 5.4 3 13.3l7.8 6C12.7 13.2 17.9 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17z"/><path fill="#FBBC05" d="M10.8 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.5 10.8l8.3-6.1z"/><path fill="#34A853" d="M24 48c6.3 0 11.6-2.1 15.4-5.7l-7.5-5.8c-2.1 1.4-4.7 2.2-7.9 2.2-6.1 0-11.3-3.7-13.2-9l-8.3 6.1C6.9 42.6 14.8 48 24 48z"/></svg>
            Войти через Google
        </a>

        <div class="auth-footer">
            Нет аккаунта? <a asp-action="Register">Регистрация</a>
        </div>
    </div>

</div>

<script src="~/js/main/effects/starPerlin.js" asp-append-version="true"></script>
}
