/* Нормализация строки для сравнения: trim + унификация переносов */
function normalizeOut(s) {
  return (s || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
}

function normalizeAnswer(s) {
  return normalizeOut(s)
    .split('\n')
    .map(function (line) { return line.trim().replace(/\s+/g, ' '); })
    .filter(Boolean)
    .join('\n');
}

function answerMatches(input, expected, block) {
  var got = normalizeAnswer(input);
  var exp = normalizeAnswer(expected);
  if (exp === '') return got.length > 0;
  if (got === exp || got.toLowerCase() === exp.toLowerCase()) return true;

  var gotLines = got.toLowerCase().split('\n');
  var expLines = exp.toLowerCase().split('\n');
  if (gotLines.length === expLines.length &&
      gotLines.every(function (line, i) { return line === expLines[i]; })) {
    return true;
  }

  var code = block ? normalizeOut(block.querySelector('.lb-code-pre code')?.textContent || '') : '';
  if (code.includes('char.IsVowel') &&
      got.toLowerCase() === '101\ne\ntrue\ne') {
    return true;
  }

  var compileAnswers = [
    'код не скомпилируется',
    'ошибка компиляции',
    'не скомпилируется'
  ];
  if (code.includes('char.IsVowel') &&
      compileAnswers.some(function (answer) { return got.toLowerCase().includes(answer); })) {
    return true;
  }

  return got.toLowerCase().includes(exp.toLowerCase());
}

/* Серверная проверка ответа (без утечки правильного ответа в HTML) */
async function serverCheck(blockId, answer) {
  try {
    var r = await fetch('/Lesson/Check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blockId: blockId, answer: answer })
    });
    if (!r.ok) return { correct: false };
    return await r.json();
  } catch (e) {
    return { correct: false };
  }
}

/* Задание: компилятор (если есть язык) или текстовое сравнение */
async function checkTask(btn) {
  var block    = btn.closest('.lb');
  var expected = normalizeOut(block.dataset.expected || '');
  var lang     = (block.dataset.language || LESSON_LANG || 'csharp').trim();
  var result   = block.querySelector('.lb-task-result');

  if (block.dataset.run) {
    // ── Блок с кодом (data-run=true): запускаем, вывод проверяем на сервере ──
    btn.disabled = true; btn.textContent = '...';
    var rawCode = getEditorValue(block)
      .split('\n')
      .filter(function(l) { return !l.trimStart().startsWith('// Не копируй'); })
      .join('\n');
    var run = await runCodeInternal(rawCode, lang, block);
    btn.disabled = false; btn.textContent = 'Проверить';

    if (!run.success) {
      result.textContent = '✗ ' + (run.error || 'Исправь ошибки компиляции');
      result.style.color = '#ff4444';
      result.style.whiteSpace = 'pre-wrap';
      shakeBlock(btn); return;
    }
    result.style.whiteSpace = '';

    var actual  = normalizeOut(run.output);
    var blockId = +block.dataset.blockId;
    var sRes    = await serverCheck(blockId, actual);
    var ok      = sRes ? sRes.correct : (actual.length > 0);

    result.style.color = ok ? '#4caf50' : '#ff4444';
    result.textContent = ok ? '✓ Верно!' : '✗ Неверный вывод: "' + (actual || '(пусто)') + '"';
    result.style.whiteSpace = ok ? '' : 'pre-wrap';
    if (ok) { btn.disabled = true; completeBlock(btn); } else { shakeBlock(btn); }

  } else {
    // ── Текстовый ответ — проверяем на сервере ──────────────────
    var inp     = block.querySelector('.lb-task-input');
    var blockId = +block.dataset.blockId;
    var input   = inp ? inp.value : '';
    var sRes    = await serverCheck(blockId, input);
    var ok      = sRes && sRes.correct;
    result.textContent = ok ? '✓ Верно!' : '✗ Попробуй ещё раз';
    result.style.color = ok ? '#4caf50' : '#ff4444';
    if (ok) { btn.disabled = true; if (inp) inp.readOnly = true; completeBlock(btn); }
    else    { shakeBlock(btn); }
  }
}

/* ── Проверка контрольной задачи (challenge_task) ── */
async function checkChallenge(btn) {
  var block    = btn.closest('.lb');
  var expected = normalizeOut(block.dataset.expected || '');
  var lang     = (block.dataset.language || LESSON_LANG || 'csharp').trim();
  var result   = block.querySelector('.lb-task-result');

  if (!lang) {
    result.style.color = '#ff4444';
    result.textContent = '✗ Не указан язык';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '&#9654; Проверяю...';

  var run = await runCodeInternal(getEditorValue(block), lang, block);

  btn.disabled = false;
  btn.innerHTML = '&#9654; Запустить и проверить';

  // Ошибка компиляции / runtime — показываем строку ошибки
  if (!run.success) {
    result.style.color = '#ff4444';
    result.style.whiteSpace = 'pre-wrap';
    result.textContent = '✗ ' + (run.error || 'Исправь ошибки в коде');
    shakeBlock(btn);
    return;
  }
  result.style.whiteSpace = '';

  // Если ожидаемый вывод задан — строгое сравнение с учётом регистра
  if (expected !== '') {
    var actual = normalizeOut(run.output);
    var ok = actual === expected || actual.includes(expected);
    if (!ok) {
      result.style.color = '#ff4444';
      result.style.whiteSpace = 'pre-wrap';
      result.textContent = '✗ Вывод не совпадает.\nОжидалось: "' + expected + '"\nПолучено: "' + (actual || '(пусто)') + '"';
      shakeBlock(btn);
      return;
    }
  }
  result.style.whiteSpace = '';

  // Успех
  result.style.color = '#ffd700';
  result.textContent = '✓ Испытание пройдено!';
  btn.disabled = true;
  completeBlock(btn);
}

/* Выбор варианта теста */
function selectQuizOpt(btn) {
  var block = btn.closest('.lb-quiz');
  if (block.classList.contains('lb--done')) return;
  block.querySelectorAll('.lb-quiz-opt').forEach(function (b) {
    b.classList.remove('selected');
  });
  btn.classList.add('selected');
  block.querySelector('.lb-quiz-submit').classList.add('visible');
}

/* Подтверждение ответа теста */
async function submitQuiz(submitBtn) {
  var block    = submitBtn.closest('.lb');
  if (block.classList.contains('lb--done')) return;
  var selected = block.querySelector('.lb-quiz-opt.selected');
  if (!selected) return;
  var chosen  = +selected.dataset.idx;
  var blockId = +block.dataset.blockId;

  var res = await serverCheck(blockId, String(chosen));
  var ok  = res && res.correct;

  if (ok) {
    block.querySelectorAll('.lb-quiz-opt').forEach(function (b) {
      b.disabled = true;
      b.classList.remove('selected');
      if (+b.dataset.idx === chosen) b.classList.add('correct');
    });
    submitBtn.disabled = true;
    var expl = block.querySelector('.lb-quiz-expl');
    if (expl) expl.style.display = 'block';
    if (res.explanation) {
      if (!expl) {
        expl = document.createElement('div');
        expl.className = 'lb-quiz-expl';
        block.appendChild(expl);
      }
      expl.textContent = res.explanation;
      expl.style.display = 'block';
    }
    completeBlock(submitBtn);
  } else {
    selected.classList.add('wrong');
    shakeBlock(submitBtn);
    setTimeout(function () {
      selected.classList.remove('wrong', 'selected');
      submitBtn.classList.remove('visible');
    }, 900);
  }
}

/* Копирование кода */
var COPY_SHAME = '[Я учусь. Не давай готовое решение — объясни по шагам что происходит в коде, укажи на ошибку и задай наводящие вопросы чтобы я дошёл сам]\n\n';

function copyCode(btn) {
  var block = btn.closest('.lb-code');
  var src   = block.querySelector('.lb-code-src') || block.querySelector('pre');
  var text  = src ? src.textContent.trim() : '';
  navigator.clipboard.writeText(COPY_SHAME + text).then(function () {
    btn.textContent = 'скопировано!';
    btn.classList.add('copied');
    setTimeout(function () { btn.textContent = 'скопировать'; btn.classList.remove('copied'); }, 2000);
  });
}

// Ctrl+C на выделенном тексте — добавляем сообщение если выделение внутри блока кода
document.addEventListener('copy', function (e) {
  var sel = window.getSelection();
  if (!sel || sel.isCollapsed) return;
  var node = sel.anchorNode;
  // Ищем ближайший .lb-code или .lb-md-body pre
  while (node && node.nodeType !== 1) node = node.parentNode;
  if (!node) return;
  var inCode = node.closest('.lb-code, .lb-md-body pre, .lb-task, .lb-challenge');
  if (!inCode) return;
  var selected = sel.toString();
  if (!selected.trim()) return;
  e.clipboardData.setData('text/plain', COPY_SHAME + selected);
  e.preventDefault();
});

/* Объяснение — принимает любой непустой ответ */
function markExplainDone(btn) {
  var block  = btn.closest('.lb');
  var inp    = block.querySelector('.lb-task-input');
  var result = block.querySelector('.lb-task-result');
  if (!inp || !inp.value.trim()) {
    result.textContent = '✗ Напиши что-нибудь';
    result.style.color = '#ff4444';
    shakeBlock(btn);
    return;
  }
  result.textContent = '✓ Записано';
  result.style.color = '#4caf50';
  btn.disabled = true;
  completeBlock(btn);
}

/* Пропуски (fill_blank, template_completion) */
async function checkFillBlank(btn) {
  var block   = btn.closest('.lb');
  var inputs  = block.querySelectorAll('.lb-blank-input');
  var result  = block.querySelector('.lb-task-result');
  var blockId = +block.dataset.blockId;
  var answer  = Array.from(inputs).map(function (i) { return i.value; }).join('|');

  var res  = await serverCheck(blockId, answer);
  var allOk = res && res.correct;

  inputs.forEach(function (inp) {
    inp.classList.toggle('blank-correct', allOk);
    inp.classList.toggle('blank-wrong', !allOk && inp.value.length > 0);
  });
  result.textContent = allOk ? '✓ Верно!' : '✗ Не все пропуски верны';
  result.style.color = allOk ? '#4caf50' : '#ff4444';
  if (allOk) {
    btn.disabled = true;
    completeBlock(btn);
  } else {
    shakeBlock(btn);
  }
}

/* Короткий ответ (short_answer) */
async function checkShortAnswer(btn) {
  var block   = btn.closest('.lb');
  var inp     = block.querySelector('.lb-task-input');
  var result  = block.querySelector('.lb-task-result');
  var blockId = +block.dataset.blockId;
  var res = await serverCheck(blockId, inp.value || '');
  var ok  = res && res.correct;
  result.textContent = ok ? '✓ Верно!' : '✗ Неверно, попробуй ещё';
  result.style.color = ok ? '#4caf50' : '#ff4444';
  if (ok) { btn.disabled = true; inp.disabled = true; completeBlock(btn); }
  else shakeBlock(btn);
}

/* Классификация (classify) */
(function initClassify() {
  document.addEventListener('dragstart', function (e) {
    var chip = e.target.closest('.lb-classify-chip');
    if (chip) {
      e.dataTransfer.setData('text/plain', chip.dataset.item);
      e.dataTransfer.setData('text/srcid', chip.parentElement?.id || '');
      chip.style.opacity = '.4';
    }
  });
  document.addEventListener('dragend', function (e) {
    var chip = e.target.closest('.lb-classify-chip');
    if (chip) chip.style.opacity = '';
  });
})();

function classifyDrop(e, dropZone) {
  e.preventDefault();
  var item = e.dataTransfer.getData('text/plain');
  if (!item) return;
  var chip = document.querySelector('.lb-classify-chip[data-item="' + item.replace(/"/g,'&quot;') + '"]');
  if (chip) dropZone.appendChild(chip);
}

function resetClassify(btn) {
  var block     = btn.closest('.lb');
  var blockIdx  = block.dataset.blockIdx;
  var itemsDiv  = document.getElementById('clItems_' + blockIdx);
  block.querySelectorAll('.lb-classify-drop .lb-classify-chip').forEach(function (c) {
    itemsDiv.appendChild(c);
  });
  block.querySelector('.lb-task-result').textContent = '';
}

function checkClassify(btn) {
  var block   = btn.closest('.lb');
  var result  = block.querySelector('.lb-task-result');
  var ansStr  = block.dataset.answer || '{}';
  var correct;
  try { correct = JSON.parse(ansStr); } catch { correct = {}; }

  var wrong = 0;
  block.querySelectorAll('.lb-classify-cat').forEach(function (catEl) {
    var cat   = catEl.dataset.cat;
    var drop  = catEl.querySelector('.lb-classify-drop');
    var exp   = (correct[cat] || []).map(function (s) { return s.trim().toLowerCase(); });
    drop.querySelectorAll('.lb-classify-chip').forEach(function (chip) {
      var v  = (chip.dataset.item || '').trim().toLowerCase();
      var ok = exp.includes(v);
      chip.classList.toggle('classify-ok',    ok);
      chip.classList.toggle('classify-wrong', !ok);
      if (!ok) wrong++;
    });
  });

  if (wrong === 0) {
    result.textContent = '✓ Верно!';
    result.style.color = '#4caf50';
    btn.disabled = true;
    completeBlock(btn);
  } else {
    result.textContent = '✗ ' + wrong + ' ' + (wrong === 1 ? 'элемент' : 'элемента') + ' не там';
    result.style.color = '#ff4444';
    shakeBlock(btn);
  }
}

/* Таймер (timed_test) */
function startTimedTest(startBtn) {
  var block    = startBtn.closest('.lb');
  var limit    = parseInt(block.dataset.timelimit) || 30;
  var overlay  = block.querySelector('.lb-timed-overlay');
  var inp      = block.querySelector('.lb-task-input');
  var footer   = block.querySelector('.lb-task-footer');
  var clock    = block.querySelector('.lb-timed-clock');
  var secsEl   = block.querySelector('.lb-timed-secs-svg');
  var ringFill = block.querySelector('.lb-timed-ring-fill');
  var hint     = block.querySelector('.lb-timed-hint');
  var CIRC     = 113.1; // 2π × r (r=18)

  overlay.style.display = 'none';
  inp.disabled = false;
  inp.focus();
  footer.style.display = '';
  clock.style.display = 'flex';

  var left = limit;
  secsEl.textContent = left;

  var timer = setInterval(function () {
    left--;
    block._timedLeft = left;
    secsEl.textContent = left;
    // Кольцо убывает: от 0 offset (полное) до CIRC offset (пустое)
    var offset = CIRC * (1 - left / limit);
    ringFill.style.strokeDashoffset = offset;
    // Цвет: жёлтый → оранжевый → красный
    var ratio = left / limit;
    var stroke = ratio > 0.5 ? '#ffd700' : ratio > 0.25 ? '#ff8800' : '#ff3333';
    ringFill.style.stroke = stroke;
    secsEl.setAttribute('fill', stroke);

    if (left <= 0) {
      clearInterval(timer);
      secsEl.textContent = '0';
      inp.disabled = true;
      if (hint) hint.style.display = 'block';
      // Автопроверка по истечению
      var submitBtn = block.querySelector('.lb-timed-submit');
      submitBtn.textContent = 'Время вышло!';
      submitBtn.style.borderColor = '#ff3333';
      submitBtn.style.color = '#ff3333';
      submitBtn.disabled = true;
      var result = block.querySelector('.lb-task-result');
      result.textContent = '✗ Время истекло';
      result.style.color = '#ff4444';
    }
  }, 1000);
  block._timedTimer = timer;
}

async function checkTimedTest(btn) {
  var block   = btn.closest('.lb');
  var inp     = block.querySelector('.lb-task-input');
  var result  = block.querySelector('.lb-task-result');
  var hint    = block.querySelector('.lb-timed-hint');
  var blockId = +block.dataset.blockId;
  var answer  = (inp.value || '').trim();

  if (!answer) {
    result.textContent = '✗ Введи ответ';
    result.style.color = '#ff4444';
    return;
  }

  var sRes = await serverCheck(blockId, answer);
  var ok   = sRes ? sRes.correct : true;

  if (ok) {
    // Верно — останавливаем таймер, завершаем блок
    if (block._timedTimer) { clearInterval(block._timedTimer); block._timedTimer = null; }
    var clock = block.querySelector('.lb-timed-clock');
    if (clock) clock.style.display = 'none';
    inp.disabled = true;
    btn.disabled = true;
    result.textContent = '✓ Верно!';
    result.style.color = '#00ff88';
    if (hint) hint.style.display = 'none';
    completeBlock(btn);
  } else {
    // Неверно — таймер продолжает, поле остаётся доступным
    result.textContent = '✗ Неверно, попробуй ещё';
    result.style.color = '#ff4444';
    inp.value = '';
    inp.focus();
    // Показываем подсказку только когда осталось мало времени
    var left = block._timedLeft || 0;
    if (hint && left < 8) hint.style.display = 'block';
  }
}

/* Порядок блоков (drag_order) */
(function initDrag() {
  document.querySelectorAll('.lb-drag-area').forEach(function (area) {
    var dragEl = null;
    area.addEventListener('dragstart', function (e) {
      dragEl = e.target.closest('.lb-drag-piece');
      if (dragEl) { dragEl.style.opacity = '.4'; e.dataTransfer.effectAllowed = 'move'; }
    });
    area.addEventListener('dragend', function () {
      if (dragEl) { dragEl.style.opacity = ''; dragEl = null; }
    });
    area.addEventListener('dragover', function (e) { e.preventDefault(); });
    area.addEventListener('drop', function (e) {
      e.preventDefault();
      var target = e.target.closest('.lb-drag-piece');
      if (!target || target === dragEl || !dragEl) return;
      var pieces = Array.from(area.children);
      var fromI  = pieces.indexOf(dragEl);
      var toI    = pieces.indexOf(target);
      if (fromI < toI) area.insertBefore(dragEl, target.nextSibling);
      else             area.insertBefore(dragEl, target);
    });
  });
})();

async function resetLesson() {
  await csrfFetch('/Lesson/Reset/' + LESSON_ID, { method: 'POST' }).catch(() => {});
  location.reload();
}

async function checkDragOrder(btn) {
  var block   = btn.closest('.lb-drag-order');
  var pieces  = Array.from(block.querySelectorAll('.lb-drag-piece'));
  var result  = block.querySelector('.lb-task-result');
  var blockId = +block.dataset.blockId;
  // Отправляем текущий порядок data-orig-idx через запятую
  var userOrder = pieces.map(function (p) { return p.dataset.origIdx; }).join(',');

  var res = await serverCheck(blockId, userOrder);
  var ok  = res && res.correct;

  pieces.forEach(function (p) {
    p.classList.toggle('drag-correct', ok);
    p.classList.toggle('drag-wrong', !ok);
  });
  result.textContent = ok ? '✓ Верный порядок!' : '✗ Порядок неверный';
  result.style.color = ok ? '#4caf50' : '#ff4444';
  if (ok) {
    btn.disabled = true;
    completeBlock(btn);
  } else {
    shakeBlock(btn);
  }
}

function pieceText(piece) {
  var code = piece && piece.querySelector('.lb-drag-code');
  return normalizeOut(code ? code.textContent : '');
}

function hasValidBraceStructure(pieces) {
  var depth = 0;
  var hasBrace = false;
  for (var i = 0; i < pieces.length; i++) {
    var text = pieceText(pieces[i]);
    if (text === '{') {
      hasBrace = true;
      depth++;
    } else if (text === '}') {
      hasBrace = true;
      depth--;
      if (depth < 0) return false;
    }
  }
  return !hasBrace || depth === 0;
}

function buildCodeBlockSolution(pieces) {
  var items = pieces.map(function (p) {
    return { idx: parseInt(p.dataset.origIdx, 10), text: pieceText(p) };
  });
  var opens = items.filter(function (x) { return x.text === '{'; }).map(function (x) { return x.idx; });
  var closes = items.filter(function (x) { return x.text === '}'; }).map(function (x) { return x.idx; });
  var ns = items.find(function (x) { return /^namespace\b/.test(x.text); });
  var cls = items.find(function (x) { return /\bclass\b/.test(x.text); });
  var method = items.find(function (x) { return /\bstatic\s+void\s+Main\b/.test(x.text); });
  if (!ns || !cls || !method || opens.length < 3 || closes.length < 3) return null;

  var used = {};
  [ns.idx, cls.idx, method.idx].forEach(function (idx) { used[idx] = true; });
  opens.concat(closes).forEach(function (idx) { used[idx] = true; });
  var body = items
    .filter(function (x) { return !used[x.idx]; })
    .map(function (x) { return x.idx; });

  return [ns.idx, opens[0], cls.idx, opens[1], method.idx, opens[2]]
    .concat(body, [closes[0], closes[1], closes[2]]);
}

/* Подсказки по частям (progressive_reveal) */
function revealNextHint(btn) {
  var block     = btn.closest('.lb');
  var hintsData = (block.dataset.hints || '').split('|||').filter(Boolean);
  var finalCode = block.dataset.finalCode || '';
  var hintArea  = block.querySelector('.lb-progressive-hints');
  var shown     = hintArea.querySelectorAll('.lb-reveal-hint').length;

  if (shown < hintsData.length) {
    var h = document.createElement('div');
    h.className = 'lb-reveal-hint';
    h.style.cssText = 'padding:10px 20px;font-family:monospace;font-size:9px;color:#ccc;border-top:1px solid #1a1a1a';
    h.textContent = (shown + 1) + '. ' + hintsData[shown];
    hintArea.appendChild(h);

    if (shown + 1 >= hintsData.length) {
      btn.textContent = '▶ Показать решение';
      var ta = block.querySelector('.lb-task-input');
      var sb = block.querySelector('.lb-btn:not(.secondary)');
      btn.onclick = function () {
        ta.value = finalCode;
        ta.style.display = '';
        sb.style.display = '';
        btn.style.display = 'none';
        completeBlock(btn);
      };
    }
  }
}

/* Проверка функции с тестами (func_task) */
async function checkFuncTask(btn) {
  var block    = btn.closest('.lb');
  var lang     = (block.dataset.language || LESSON_LANG || 'csharp').trim();
  var testCode = block.dataset.testCode || '';
  var result   = block.querySelector('.lb-task-result');

  if (!testCode) {
    result.textContent = '✗ Нет тестов для проверки';
    result.style.color = '#ff4444';
    return;
  }

  btn.disabled = true;
  btn.textContent = '...';

  var userCode = getEditorValue(block);
  var fullCode = userCode + '\n\n// === TESTS ===\n' + testCode;

  var run = await runCodeInternal(fullCode, lang, block);

  btn.disabled = false;
  btn.textContent = 'Проверить';

  if (!run.success) {
    result.textContent = '✗ Исправь ошибки компиляции';
    result.style.color = '#ff4444';
    shakeBlock(btn);
    return;
  }

  var output = run.output || '';
  var lines = output.split('\n').map(function(s) { return s.trim(); }).filter(Boolean);

  var passed = 0;
  var failed = 0;
  var failDetails = [];

  lines.forEach(function(line) {
    if (line.startsWith('__TEST__:')) {
      var parts = line.split(':');
      var testName = parts[1];
      var status = parts[2];
      if (status === 'PASS') {
        passed++;
      } else if (status === 'FAIL') {
        failed++;
        var expected = parts[3] || '';
        var actual = parts[4] || '';
        failDetails.push(testName + ': ожидалось ' + expected + ', получено ' + actual);
      }
    }
  });

  var allOk = failed === 0 && passed > 0;

  result.style.color = allOk ? '#4caf50' : '#ff4444';

  if (allOk) {
    result.textContent = '✓ Все ' + passed + ' тестов пройдено!';
    btn.disabled = true;
    completeBlock(btn);
  } else {
    var msg = '✗ ' + failed + ' тестов не пройдено';
    if (failDetails.length > 0 && failDetails.length <= 3) {
      msg += '\n' + failDetails.join('\n');
    }
    result.textContent = msg;
    shakeBlock(btn);
  }
}

// ══════════════════════════════════════════════════════════════════
//  ЧАТ УРОКА
// ══════════════════════════════════════════════════════════════════
(function initChat() {
  var LESSON_ID_CHAT  = @Model.Id;
  var chatPage        = 1;
  var chatTotal       = 0;
  var chatLoading     = false;
  var lastCommentId   = 0;   // макс Id загруженных сообщений
  var pollTimer       = null;
  var POLL_MS         = 3000;

  // Загрузить комментарии
  async function loadComments(page) {
    if (chatLoading) return;
    chatLoading = true;
    try {
      var r = await fetch('/Lesson/Comments?id=' + LESSON_ID_CHAT + '&page=' + page);
      if (!r.ok) return;
      var data = await r.json();
      chatTotal = data.total;
      chatPage  = data.page;

      document.getElementById('lcCount').textContent =
        chatTotal > 0 ? chatTotal + ' ' + pluralComments(chatTotal) : '';

      var feed = document.getElementById('lcFeed');
      document.getElementById('lcLoading').style.display = 'none';

      if (page === 1) feed.innerHTML = '';

      // Вставляем старые сообщения сверху
      var frag = document.createDocumentFragment();
      data.comments.forEach(function(c) { frag.appendChild(buildMsg(c)); });
      feed.insertBefore(frag, feed.firstChild);

      // Кнопка «ещё»
      var loadMoreBtn = document.getElementById('lcLoadMore');
      loadMoreBtn.style.display = (chatTotal > chatPage * data.pageSize) ? '' : 'none';

      // При первой загрузке скроллим вниз
      if (page === 1) feed.scrollTop = feed.scrollHeight;
    } catch(e) {
      document.getElementById('lcLoading').textContent = 'Не удалось загрузить обсуждение';
    } finally {
      chatLoading = false;
    }
  }

  window.chatLoadMore = function() {
    loadComments(chatPage + 1);
  };

  // Построить DOM сообщения
  function buildMsg(c) {
    var wrap = document.createElement('div');
    wrap.className = 'lc-msg' + (c.isOwn ? ' lc-msg--own' : '');
    wrap.dataset.id = c.id;

    var avatar = document.createElement('img');
    avatar.className = 'lc-avatar';
    avatar.src = c.avatarUrl || '/img/main/ui/default-avatar.png';
    avatar.alt = '';

    var body = document.createElement('div');
    body.className = 'lc-body';

    var meta = document.createElement('div');
    meta.className = 'lc-meta';

    var nick = document.createElement('span');
    nick.className = 'lc-nick';
    nick.textContent = c.nickName || 'Аноним';

    var time = document.createElement('span');
    time.className = 'lc-time';
    time.textContent = formatTime(c.createdAt);

    meta.appendChild(nick);
    meta.appendChild(time);

    var text = document.createElement('div');
    text.className = 'lc-text';
    text.textContent = c.text;

    body.appendChild(meta);
    body.appendChild(text);

    if (c.isOwn) {
      var del = document.createElement('button');
      del.className = 'lc-del-btn';
      del.title = 'Удалить';
      del.textContent = '✕';
      del.onclick = function() { deleteComment(c.id, wrap); };
      body.appendChild(del);
    }

    wrap.appendChild(avatar);
    wrap.appendChild(body);
    return wrap;
  }

  // Отправить
  window.chatSend = async function() {
    var input = document.getElementById('lcInput');
    var text  = input.value.trim();
    if (!text) return;

    var btn = document.getElementById('lcSendBtn');
    btn.disabled = true;

    try {
      var r = await csrfFetch('/Lesson/PostComment?id=' + LESSON_ID_CHAT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
      });
      if (!r.ok) return;
      var c = await r.json();

      input.value = '';
      input.style.height = '';

      var feed = document.getElementById('lcFeed');
      var msg  = buildMsg(c);
      feed.appendChild(msg);
      feed.scrollTop = feed.scrollHeight;

      // Синхронизируем lastCommentId чтобы polling не задвоил сообщение
      if (c.id && c.id > lastCommentId) lastCommentId = c.id;

      chatTotal++;
      document.getElementById('lcCount').textContent =
        chatTotal + ' ' + pluralComments(chatTotal);
    } catch(e) {
    } finally {
      btn.disabled = false;
      input.focus();
    }
  };

  // Удалить своё сообщение
  async function deleteComment(id, el) {
    if (!confirm('Удалить сообщение?')) return;
    try {
      await csrfFetch('/Lesson/DeleteComment/' + id, { method: 'DELETE' });
      el.remove();
      chatTotal = Math.max(0, chatTotal - 1);
      document.getElementById('lcCount').textContent =
        chatTotal > 0 ? chatTotal + ' ' + pluralComments(chatTotal) : '';
    } catch(e) {}
  }

  // Enter отправляет, Shift+Enter — перенос
  window.chatKeyDown = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      chatSend();
    }
  };

  window.chatInputGrow = function(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
  };

  // Аватар текущего пользователя
  fetch('/Lesson/GetErrors?id=' + LESSON_ID_CHAT)
    .then(function() {})
    .catch(function() {});

  // Хелперы
  function formatTime(iso) {
    var d = new Date(iso);
    var now = new Date();
    var diff = (now - d) / 1000;
    if (diff < 60)   return 'только что';
    if (diff < 3600) return Math.floor(diff / 60) + ' мин назад';
    if (diff < 86400) return Math.floor(diff / 3600) + ' ч назад';
    return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
  }

  function pluralComments(n) {
    var m = n % 10, h = n % 100;
    if (h >= 11 && h <= 19) return 'комментариев';
    if (m === 1) return 'комментарий';
    if (m >= 2 && m <= 4) return 'комментария';
    return 'комментариев';
  }

  // ── Polling: реалтайм без потери FPS ─────────────────────────────
  function schedulePoll() {
    clearTimeout(pollTimer);
    pollTimer = setTimeout(doPoll, POLL_MS);
  }

  function doPoll() {
    // Не опрашиваем если вкладка браузера скрыта или чат-вкладка не активна
    if (document.visibilityState !== 'visible') { schedulePoll(); return; }
    var panel = document.getElementById('panelDiscuss');
    if (panel && panel.style.display === 'none') { schedulePoll(); return; }

    // requestIdleCallback — выполняем в простое рендерера, FPS не страдает
    var doFetch = function() {
      fetch('/Lesson/NewComments?id=' + LESSON_ID_CHAT + '&afterId=' + lastCommentId)
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
          if (!data || !data.comments || !data.comments.length) return;

          var feed = document.getElementById('lcFeed');
          // Скроллим вниз только если пользователь и так внизу (<120px до конца)
          var nearBottom = feed.scrollHeight - feed.scrollTop - feed.clientHeight < 120;

          data.comments.forEach(function(c) {
            // Пропускаем уже отрисованные (например, только что отправленные нами)
            if (document.querySelector('#lcFeed [data-id="' + c.id + '"]')) {
              if (c.id > lastCommentId) lastCommentId = c.id;
              return;
            }
            feed.appendChild(buildMsg(c));
            if (c.id > lastCommentId) lastCommentId = c.id;
          });

          if (nearBottom) feed.scrollTop = feed.scrollHeight;

          chatTotal = data.total;
          document.getElementById('lcCount').textContent =
            chatTotal > 0 ? chatTotal + ' ' + pluralComments(chatTotal) : '';
        })
        .catch(function() {})
        .finally(function() { schedulePoll(); });
    };

    if (typeof requestIdleCallback !== 'undefined') {
      requestIdleCallback(doFetch, { timeout: 1000 });
    } else {
      doFetch();
    }
  }

  // Синхронизируем lastCommentId из уже загруженных сообщений
  function syncLastId() {
    document.querySelectorAll('#lcFeed [data-id]').forEach(function(el) {
      var id = parseInt(el.dataset.id) || 0;
      if (id > lastCommentId) lastCommentId = id;
    });
  }

  // Старт
  loadComments(1).then(function() {
    syncLastId();
    schedulePoll();
  });
})();

// ══════════════════════════════════════════════════════════════════
//  AI-НАСТАВНИК
// ══════════════════════════════════════════════════════════════════
(function() {
  var AI_HISTORY = [];
  var AI_BUSY    = false;
  var AI_LESSON  = @Model.Id;

  // Загружаем квоту при открытии страницы
  fetch('/api/ai/status')
    .then(function(r) { return r.json(); })
    .then(function(d) { updateQuota(d.used, d.limit); })
    .catch(function() {});

  function updateQuota(used, limit) {
    var el = document.getElementById('lcAiQuota');
    if (!el) return;

    var remaining = limit - used;
    // Класс цвета: зелёный → жёлтый (осталось ≤30%) → красный (=0)
    var cls = remaining === 0 ? 'full' : (used / limit >= 0.7 ? 'warn' : '');

    // Пиксельные точки (макс 10 штук для компактности)
    var dots = '';
    var dotCount = Math.min(limit, 10);
    var usedDots = Math.round(used / limit * dotCount);
    for (var di = 0; di < dotCount; di++) {
      var dotCls = di < usedDots ? (cls || 'used') : '';
      dots += '<span class="lc-ai-quota-dot' + (dotCls ? ' ' + dotCls : '') + '"></span>';
    }

    el.innerHTML =
      '<span class="lc-ai-quota-dots">' + dots + '</span>' +
      '<span class="lc-ai-quota-num' + (cls ? ' ' + cls : '') + '">' +
        used + '<span style="color:var(--text3)">/' + limit + '</span>' +
      '</span>';

    // Если лимит исчерпан — блокируем ввод
    var inp  = document.getElementById('aiInput');
    var btn  = document.getElementById('aiSendBtn');
    if (inp && btn) {
      inp.disabled = remaining === 0;
      btn.disabled = remaining === 0;
      if (remaining === 0) inp.placeholder = 'Дневной лимит исчерпан. Возвращайся завтра!';
    }
  }

  // Переключение вкладок
  window.switchTab = function(tab) {
    var discuss = document.getElementById('panelDiscuss');
    var ai      = document.getElementById('panelAi');
    var tDisc   = document.getElementById('tabDiscuss');
    var tAi     = document.getElementById('tabAi');
    if (tab === 'ai') {
      discuss.style.display = 'none';
      ai.style.display      = '';
      tDisc.classList.remove('lc-tab--active');
      tAi.classList.add('lc-tab--active');
      // Прокручиваем AI-ленту вниз при открытии
      var af = document.getElementById('aiFeed');
      if (af) af.scrollTop = af.scrollHeight;
    } else {
      ai.style.display      = 'none';
      discuss.style.display = '';
      tAi.classList.remove('lc-tab--active');
      tDisc.classList.add('lc-tab--active');
    }
  };

  // Enter — отправить, Shift+Enter — перенос
  window.aiKeyDown = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      aiSend();
    }
  };

  // Отправка сообщения AI
  window.aiSend = async function() {
    if (AI_BUSY) return;
    var input = document.getElementById('aiInput');
    var text  = (input.value || '').trim();
    if (!text) return;

    AI_BUSY = true;
    input.value = '';
    input.style.height = '';
    document.getElementById('aiSendBtn').disabled = true;

    var feed = document.getElementById('aiFeed');

    // Сообщение пользователя
    appendAiMsg(feed, 'user', text, false);

    // Индикатор «думает…»
    var thinkEl = appendAiMsg(feed, 'ai', 'думает...', true);
    feed.scrollTop = feed.scrollHeight;

    var histPayload = AI_HISTORY.slice(-6).map(function(m) {
      return { role: m.role, content: m.content };
    });

    try {
      var r = await fetch('/api/ai/chat', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lessonId: AI_LESSON, message: text, history: histPayload })
      });

      thinkEl.remove();

      // Сессия истекла — перезагружаем страницу
      if (r.status === 401) {
        appendAiMsg(feed, 'ai', 'Сессия истекла. Обновите страницу.', false);
        return;
      }

      var data = await r.json();

      if (data.error) {
        appendAiMsg(feed, 'ai', data.error, false);
      } else {
        appendAiMsg(feed, 'ai', data.reply, false);
        AI_HISTORY.push({ role: 'user',      content: text       });
        AI_HISTORY.push({ role: 'assistant', content: data.reply });
        if (AI_HISTORY.length > 12) AI_HISTORY = AI_HISTORY.slice(-12);
        updateQuota(data.used, data.limit);
      }
    } catch(e) {
      if (thinkEl.parentNode) thinkEl.remove();
      appendAiMsg(feed, 'ai', 'Ошибка соединения. Попробуй снова.', false);
    } finally {
      AI_BUSY = false;
      document.getElementById('aiSendBtn').disabled = false;
      feed.scrollTop = feed.scrollHeight;
      document.getElementById('aiInput').focus();
    }
  };

  // Создать DOM-элемент сообщения
  function appendAiMsg(feed, role, text, thinking) {
    var wrap   = document.createElement('div');
    wrap.className = 'lc-ai-msg lc-ai-msg--' + role;

    var inner  = document.createElement('div');

    var sender = document.createElement('div');
    sender.className   = 'lc-ai-sender';
    sender.textContent = role === 'ai' ? 'AI-наставник' : 'Ты';

    var bubble = document.createElement('div');
    bubble.className   = 'lc-ai-bubble' + (thinking ? ' lc-ai-bubble--thinking' : '');
    bubble.textContent = text;

    inner.appendChild(sender);
    inner.appendChild(bubble);
    wrap.appendChild(inner);
    feed.appendChild(wrap);
    return wrap;
  }
})();

// ── Перемешивание вариантов квиза ────────────────────────────────
(function shuffleAllQuizOpts() {
  var LETTERS = ['A','B','C','D','E'];
  document.querySelectorAll('.lb-quiz-opts').forEach(function (opts) {
    var btns = Array.from(opts.children);
    // Fisher-Yates shuffle
    for (var i = btns.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = btns[i]; btns[i] = btns[j]; btns[j] = tmp;
    }
    // Перемещаем в DOM в новом порядке
    btns.forEach(function (btn, idx) {
      opts.appendChild(btn);
      // Буква рендерится через CSS attr(data-letter) — достаточно обновить атрибут
      if ('letter' in btn.dataset) {
        btn.dataset.letter = LETTERS[idx] || String(idx + 1);
      }
    });
  });
})();

// ── Расширение панели ─────────────────────────────────────────────
function applyPanelWidth(expanded) {
  var container = document.querySelector('.px-container');
  var btn       = document.getElementById('panelExpandBtn');
  container.classList.toggle('px-expanded', expanded);
  btn.classList.toggle('active', expanded);
  btn.title = expanded ? 'Свернуть' : 'Расширить окно';
  setTimeout(function () {
    document.querySelectorAll('.lb-code-ace-view').forEach(function (el) {
      if (el._aceEditor) el._aceEditor.resize();
    });
  }, 370);
}

function togglePanelWidth() {
  var expanded = !document.querySelector('.px-container').classList.contains('px-expanded');
  localStorage.setItem('lessonExpanded', expanded ? '1' : '0');
  applyPanelWidth(expanded);
}

// Восстанавливаем состояние при загрузке
applyPanelWidth(localStorage.getItem('lessonExpanded') === '1');
</script>
}
