@model CodeLearn.Models.Lesson
@using System.Text.Json
@using Markdig

@section Styles {
    <link rel="stylesheet" href="~/css/lesson/lesson.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
}

@section FullPage {

<canvas id="bg-canvas"></canvas>
<canvas id="rain-canvas"></canvas>
<canvas id="stars-canvas"></canvas>
<canvas id="fog-canvas"></canvas>
<div class="crt-scanlines"></div>
<div class="crt-overlay"></div>

@{
  var blockCount    = Model.ContentBlocks.Count;
  bool alreadyDone  = ViewBag.IsCompleted == true;
  var savedCompletedBlocks = alreadyDone
      ? blockCount
      : Math.Clamp((int)(ViewBag.CompletedBlockCount ?? 0), 0, blockCount);
  var defaultLang   = (string)(ViewBag.DefaultLang ?? "csharp");
}

<!-- Прогресс-бар (sticky) -->
<div class="lesson-progress-bar">
  <div class="lesson-progress-fill" id="lpFill"
       style="width:@(blockCount == 0 ? "0" : Math.Round(savedCompletedBlocks / (double)blockCount * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
</div>
<div class="lesson-progress-label">
  <span class="lesson-progress-steps" id="lpSteps">
    @(alreadyDone ? "урок завершён ✓" : $"блок {savedCompletedBlocks} из {blockCount}")
  </span>
  <span class="lesson-progress-title">@Model.Title.StripEmoji()</span>
</div>

<!-- Счётчик ошибок (верхний правый угол) -->
<div class="lesson-error-badge" id="errorBadge" aria-live="polite">
  <span class="err-icon">✗</span>
  <span class="err-title">ошибки урока</span>
  <span id="errorCount">0</span>
</div>

<script>
  // Загружаем количество ошибок при входе на страницу
  (async function() {
    try {
      const res = await fetch('/Lesson/GetErrors?id=@Model.Id');
      if (res.ok) {
        const data = await res.json();
        document.getElementById('errorCount').textContent = data.lessonErrors || 0;
      }
    } catch(e) {}
  })();
</script>

<div class="px-page">
  <div class="px-container">

    <!-- Хлебные крошки -->
    <nav class="breadcrumb">
      <a asp-controller="Main" asp-action="Index" class="breadcrumb-item breadcrumb-link">
        <span class="bc-arrow">←</span> Карта
      </a>
      <span class="breadcrumb-sep">›</span>
      @if (Model.Module != null)
      {
        <a asp-controller="Course" asp-action="Index" asp-route-id="@Model.ModuleId" class="breadcrumb-item breadcrumb-link">
          @Model.Module.Title.StripEmoji()
        </a>
        <span class="breadcrumb-sep">›</span>
      }
      <span class="breadcrumb-item active">@Model.Title.StripEmoji()</span>
    </nav>

    <!-- Заголовок -->
    <div class="px-title">@Model.Title.StripEmoji()</div>

    <!-- Панель-окно с контентом -->
    <div class="px-panel">
      <div class="panel-titlebar">
        <div class="panel-dot"></div>
        <div class="panel-dot"></div>
        <div class="panel-dot"></div>
        <span class="panel-title">lesson.cs</span>
        @if (Model.Module != null)
        {
          <span class="panel-tag">@Model.Module.Title.StripEmoji()</span>
        }
        <button class="panel-expand-btn" id="panelExpandBtn" onclick="togglePanelWidth()" title="Расширить окно">⇔</button>
      </div>
      <div class="panel-body">

        <!-- Блоки контента -->
        <div class="lesson-blocks @(alreadyDone ? "lesson--completed" : "")" id="lessonBlocks">

          @foreach (var (block, blockIdx) in Model.ContentBlocks.Select((b, i) => (b, i)))
          {
            var content     = JsonDocument.Parse(block.Content).RootElement;
            var isVisible   = blockIdx <= savedCompletedBlocks || alreadyDone;
            var hiddenStyle = isVisible ? "" : "display:none";
            // Язык компилятора: из блока, иначе fallback по языку курса
            var _rawLang  = content.TryGetProperty("language", out var _bLang) ? (_bLang.GetString() ?? "") : "";
            var blockLang = string.IsNullOrEmpty(_rawLang) ? defaultLang : _rawLang;

            @* ── ТЕКСТ ─────────────────────────────────────────────────────── *@
            @if (block.Type == "text")
            {
              var mdRaw = content.TryGetProperty("markdown", out var _md) ? (_md.GetString() ?? "")
                        : content.TryGetProperty("body", out var _body) ? (_body.GetString() ?? "") : "";
              var mdHtml = Markdown.ToHtml(mdRaw, new MarkdownPipelineBuilder()
                  .UseAdvancedExtensions()
                  .DisableHtml()   // XSS: запрещаем raw HTML внутри Markdown
                  .Build());
              <div class="lb lb-text" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-type-tag">теория</div>
                <div class="lb-md-body">@Html.Raw(mdHtml)</div>
                @if (!alreadyDone) {
                  <div class="lb-continue">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

            @* ── КОД ───────────────────────────────────────────────────────── *@
            else if (block.Type == "code")
            {
              var lang     = content.TryGetProperty("language", out var l) ? l.GetString() : "code";
              var code     = content.TryGetProperty("code",     out var c) ? c.GetString() : "";
              var title    = content.TryGetProperty("title",    out var t) ? t.GetString() : "";
              var aceLang  = (lang == "python") ? "python" : "csharp";
              <div class="lb lb-code" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-code-header">
                  <span class="lb-code-title">@(string.IsNullOrEmpty(title) ? "Код" : title)</span>
                  <div class="lb-code-right">
                    <span class="lb-code-lang">@lang</span>
                    <button class="lb-copy-btn" onclick="copyCode(this)">скопировать</button>
                  </div>
                </div>
                @* Ace read-only viewer — provides proper syntax highlighting *@
                <div class="lb-code-ace-view" data-lang="@aceLang"></div>
                @* Hidden source: Razor-encodes special chars; .textContent gives raw code for Ace *@
                <pre class="lb-code-src" style="display:none">@code</pre>
                @if (!alreadyDone) {
                  <div class="lb-continue">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

            @* ── ЗАДАНИЕ ────────────────────────────────────────────────────── *@
            else if (block.Type == "task")
            {
              var tTitle = content.TryGetProperty("title",          out var tt) ? tt.GetString() : "Задание";
              var tDesc  = content.TryGetProperty("description",    out var td) ? td.GetString() : "";
              var tCode  = content.TryGetProperty("starterCode",    out var tc) ? tc.GetString() : "";
              var tOut   = content.TryGetProperty("expectedOutput", out var to) ? to.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@tCode" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">задание</span>
                  <span class="lb-task-title">@tTitle</span>
                </div>
                @if (!string.IsNullOrEmpty(tDesc)) { <div class="lb-task-desc">@tDesc</div> }
                <textarea class="lb-task-input" spellcheck="false" placeholder="Напиши решение..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ТЕСТ ───────────────────────────────────────────────────────── *@
            else if (block.Type == "quiz")
            {
              var question = content.TryGetProperty("question",    out var q)   ? q.GetString()   : "";
              var correct  = content.TryGetProperty("correct",     out var cor) ? cor.GetInt32()  : 0;
              var expl     = content.TryGetProperty("explanation", out var ex)  ? ex.GetString()  : "";
              var options  = content.TryGetProperty("options", out var opts)
                  ? opts.EnumerateArray().Select(o => o.GetString()).ToList()
                  : new List<string?>();
              var letters  = new[] { "A", "B", "C", "D", "E" };
              <div class="lb lb-quiz" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-quiz-header">
                  <span class="lb-quiz-badge">тест</span>
                  <span class="lb-quiz-q">@question</span>
                </div>
                <div class="lb-quiz-opts">
                  @for (int i = 0; i < options.Count; i++) {
                    <button class="lb-quiz-opt"
                            data-letter="@(i < letters.Length ? letters[i] : (i+1).ToString())"
                            data-idx="@i" onclick="selectQuizOpt(this)">
                      @options[i]
                    </button>
                  }
                </div>
                <button class="lb-quiz-submit" onclick="submitQuiz(this)">Подтвердить ответ</button>
                @if (!string.IsNullOrEmpty(expl)) { <div class="lb-quiz-expl" style="display:none">@expl</div> }
              </div>
            }

            @* ── КНОПКА ─────────────────────────────────────────────────────── *@
            else if (block.Type == "button")
            {
              var btnText    = content.TryGetProperty("text",    out var bt) ? bt.GetString() : "Далее";
              var btnHref    = content.TryGetProperty("href",    out var bh) ? bh.GetString() : "#";
              var btnVariant = content.TryGetProperty("variant", out var bv) ? bv.GetString() : "primary";
              <div class="lb lb-button" data-block-idx="@blockIdx" style="@hiddenStyle">
                <a href="@btnHref" class="lb-btn @(btnVariant == "secondary" ? "secondary" : "")">@btnText</a>
                @if (!alreadyDone) {
                  <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                }
              </div>
            }

            @* ── ПРЕДСКАЗАНИЕ ────────────────────────────────────────────────── *@
            else if (block.Type == "prediction")
            {
              var predCode     = content.TryGetProperty("code",           out var pc) ? pc.GetString() : "";
              var predExpected = content.TryGetProperty("expectedOutput", out var pe) ? pe.GetString() : "";
              var predHint     = content.TryGetProperty("hint",           out var ph) ? ph.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">предсказание</span>
                  <span class="lb-task-title">Что выведет этот код?</span>
                </div>
                <pre class="lb-code-pre" style="border-bottom:2px solid #1a1a1a"><code class="language-csharp">@predCode</code></pre>
                @if (!string.IsNullOrEmpty(predHint)) { <div class="lb-task-hint">@predHint</div> }
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Введи свой ответ..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ПРАВКА СТРОКИ ───────────────────────────────────────────────── *@
            else if (block.Type == "modify")
            {
              var modCode  = content.TryGetProperty("code",             out var mc) ? mc.GetString() : "";
              var modInstr = content.TryGetProperty("modifyInstruction",out var mi) ? mi.GetString() : "";
              var modExp   = content.TryGetProperty("expectedOutput",   out var me) ? me.GetString() : "";
              var modHint  = content.TryGetProperty("hint",             out var mh) ? mh.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">правка строки</span>
                  <span class="lb-task-title">@modInstr</span>
                </div>
                <textarea class="lb-task-input" spellcheck="false">@modCode</textarea>
                @if (!string.IsNullOrEmpty(modHint)) { <div class="lb-task-hint">@modHint</div> }
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ПРОПУСКИ ────────────────────────────────────────────────────── *@
            else if (block.Type == "fill_blank")
            {
              var fbTemplate = content.TryGetProperty("template", out var fbt) ? fbt.GetString() : "";
              var fbBlanks   = content.TryGetProperty("blanks",   out var fbb)
                  ? fbb.EnumerateArray().Select(b => b.GetString()).ToList() : new List<string?>();
              var fbHint     = content.TryGetProperty("hint",     out var fbh) ? fbh.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">пропуски</span>
                  <span class="lb-task-title">Заполни пропуски</span>
                </div>
                @if (!string.IsNullOrEmpty(fbHint)) { <div class="lb-task-desc">@fbHint</div> }
                @{
                  var fbParts = fbTemplate!.Split("___");
                  var fbSb = new System.Text.StringBuilder();
                  for (int fi = 0; fi < fbParts.Length; fi++) {
                    fbSb.Append("<span class=\"fb-part\">");
                    fbSb.Append(System.Net.WebUtility.HtmlEncode(fbParts[fi]));
                    fbSb.Append("</span>");
                    if (fi < fbParts.Length - 1) {
                      var fbAnsLen = fi < fbBlanks.Count ? (fbBlanks[fi]?.Length ?? 5) : 5;
                      var fbW = Math.Max(60, fbAnsLen * 11);
                      fbSb.Append($"<input class=\"lb-blank-input\" type=\"text\" data-blank-idx=\"{fi}\" style=\"width:{fbW}px\" spellcheck=\"false\">");
                    }
                  }
                }
                <div class="lb-fill-blank-area">@Html.Raw(fbSb.ToString())</div>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkFillBlank(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── БАГ ─────────────────────────────────────────────────────────── *@
            else if (block.Type == "fix_bug")
            {
              var bugCode = content.TryGetProperty("buggyCode",      out var bbc) ? bbc.GetString() : "";
              var bugExp  = content.TryGetProperty("expectedOutput", out var bbe) ? bbe.GetString() : "";
              var bugHint = content.TryGetProperty("hint",           out var bbh) ? bbh.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@bugCode" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">баг</span>
                  <span class="lb-task-title">Найди и исправь ошибку</span>
                </div>
                @if (!string.IsNullOrEmpty(bugHint)) { <div class="lb-task-hint">@bugHint</div> }
                <textarea class="lb-task-input" spellcheck="false">@bugCode</textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── МИНИ-ЗАДАЧА ─────────────────────────────────────────────────── *@
            else if (block.Type == "mini_task")
            {
              var mtTitle = content.TryGetProperty("title",          out var mtt) ? mtt.GetString() : "Мини-задача";
              var mtDesc  = content.TryGetProperty("description",    out var mtd) ? mtd.GetString() : "";
              var mtCode  = content.TryGetProperty("starterCode",    out var mtc) ? mtc.GetString() : "";
              var mtExp   = content.TryGetProperty("expectedOutput", out var mte) ? mte.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@mtCode" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">мини</span>
                  <span class="lb-task-title">@mtTitle</span>
                </div>
                @if (!string.IsNullOrEmpty(mtDesc)) { <div class="lb-task-desc">@mtDesc</div> }
                <textarea class="lb-task-input" spellcheck="false">@mtCode</textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ОБЪЯСНЕНИЕ ───────────────────────────────────────────────────── *@
            else if (block.Type == "explain")
            {
              var exlPrompt = content.TryGetProperty("prompt",       out var ep) ? ep.GetString() : "Объясни, что делает этот код:";
              var exlCode   = content.TryGetProperty("codeSnippet",  out var ec) ? ec.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">объяснение</span>
                  <span class="lb-task-title">@exlPrompt</span>
                </div>
                @if (!string.IsNullOrEmpty(exlCode)) {
                  <pre class="lb-code-pre" style="border-bottom:2px solid #1a1a1a"><code class="language-csharp">@exlCode</code></pre>
                }
                <textarea class="lb-task-input" spellcheck="false" style="min-height:80px" placeholder="Напиши объяснение в 1–2 предложениях..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="markExplainDone(this)">Готово</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── НАМЕРЕНИЕ → КОД ─────────────────────────────────────────────── *@
            else if (block.Type == "intent_to_code")
            {
              var itcIntent = content.TryGetProperty("intent",          out var ii) ? ii.GetString() : "";
              var itcExp    = content.TryGetProperty("expectedOutput",  out var ie) ? ie.GetString() : "";
              var itcHint   = content.TryGetProperty("hint",            out var ih) ? ih.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">намерение→код</span>
                  <span class="lb-task-title">@itcIntent</span>
                </div>
                @if (!string.IsNullOrEmpty(itcHint)) { <div class="lb-task-hint">@itcHint</div> }
                <textarea class="lb-task-input" spellcheck="false" placeholder="Напиши код, который это делает..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── КОНТРОЛЬНЫЙ ВОПРОС ───────────────────────────────────────────── *@
            else if (block.Type == "control_question")
            {
              var cqQuestion = content.TryGetProperty("question", out var cqq) ? cqq.GetString() : "";
              var cqAnswer   = content.TryGetProperty("answer",   out var cqa) ? cqa.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">контроль</span>
                  <span class="lb-task-title">@cqQuestion</span>
                </div>
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Твой ответ..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ПО ТЕМЕ / ПЕРЕНОС ────────────────────────────────────────────── *@
            else if (block.Type == "knowledge_check" || block.Type == "transfer_test")
            {
              var kcQ     = content.TryGetProperty("question",    out var kcq) ? kcq.GetString() : "";
              var kcC     = content.TryGetProperty("correct",     out var kcc) ? kcc.GetInt32()  : 0;
              var kcExpl  = content.TryGetProperty("explanation", out var kce) ? kce.GetString() : "";
              var kcTopic = content.TryGetProperty("topic",       out var kct) ? kct.GetString() : "";
              var kcOpts  = content.TryGetProperty("options",     out var kco)
                  ? kco.EnumerateArray().Select(o => o.ValueKind == JsonValueKind.String ? o.GetString() : (o.ValueKind == JsonValueKind.Null ? null : o.GetRawText())).ToList() : new List<string?>();
              var kcLetters = new[] { "A", "B", "C", "D" };
              var kcBadge   = block.Type == "transfer_test" ? "перенос" : "по теме";
              <div class="lb lb-quiz" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-quiz-header">
                  <span class="lb-quiz-badge">@kcBadge</span>
                  <span class="lb-quiz-q">@(string.IsNullOrEmpty(kcTopic) ? kcQ : $"[{kcTopic}] {kcQ}")</span>
                </div>
                <div class="lb-quiz-opts">
                  @for (int ki = 0; ki < kcOpts.Count; ki++) {
                    <button class="lb-quiz-opt"
                            data-letter="@(ki < kcLetters.Length ? kcLetters[ki] : (ki+1).ToString())"
                            data-idx="@ki" onclick="selectQuizOpt(this)">@kcOpts[ki]</button>
                  }
                </div>
                <button class="lb-quiz-submit" onclick="submitQuiz(this)">Подтвердить</button>
                @if (!string.IsNullOrEmpty(kcExpl)) { <div class="lb-quiz-expl" style="display:none">@kcExpl</div> }
              </div>
            }

            @* ── НА ВРЕМЯ ─────────────────────────────────────────────────────── *@
            else if (block.Type == "timed_test")
            {
              var ttQ    = content.TryGetProperty("question",      out var ttq) ? ttq.GetString() : "";
              var ttTime = content.TryGetProperty("timeLimit",     out var ttt) ? ttt.GetInt32()  : 30;
              var ttExp  = content.TryGetProperty("expectedOutput",out var tte) ? tte.GetString() : "";
              var ttHint = content.TryGetProperty("hint",          out var tth) ? tth.GetString() : "";
              <div class="lb lb-task lb-timed" data-block-idx="@blockIdx" data-block-id="@block.Id" data-timelimit="@ttTime" data-language="@blockLang" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">⏱ на время</span>
                  <span class="lb-task-title">@ttQ</span>
                  <span class="lb-timed-clock" style="display:none">
                    <svg class="lb-timed-ring" viewBox="0 0 44 44">
                      <circle cx="22" cy="22" r="18" fill="none" stroke="#1a1a1a" stroke-width="3"/>
                      <circle class="lb-timed-ring-fill" cx="22" cy="22" r="18" fill="none" stroke="#ffd700" stroke-width="3"
                              stroke-dasharray="113.1 113.1" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 22 22)"/>
                      <text class="lb-timed-secs-svg" x="22" y="27" text-anchor="middle" font-size="12" fill="#ffd700" font-family="monospace">@ttTime</text>
                    </svg>
                  </span>
                </div>
                @if (!string.IsNullOrEmpty(ttHint)) { <div class="lb-task-hint lb-timed-hint" style="display:none">@ttHint</div> }
                <div class="lb-timed-overlay">
                  <button class="lb-btn lb-timed-start" onclick="startTimedTest(this)">▶ Начать (@ttTime с)</button>
                </div>
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Ответ..." disabled></textarea>
                <div class="lb-task-footer" style="display:none">
                  <button class="lb-btn lb-timed-submit" onclick="checkTimedTest(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── СРАВНЕНИЕ ВАРИАНТОВ ──────────────────────────────────────────── *@
            else if (block.Type == "compare_variants")
            {
              var cvQ       = content.TryGetProperty("question",    out var cvq) ? cvq.GetString() : "";
              var cvCorrect = content.TryGetProperty("correct",     out var cvc) ? cvc.GetInt32()  : 0;
              var cvExpl    = content.TryGetProperty("explanation", out var cve) ? cve.GetString() : "";
              var cvVariants = content.TryGetProperty("variants",   out var cvv)
                  ? cvv.EnumerateArray().Select(v => new {
                      title = v.TryGetProperty("title", out var vt) ? vt.GetString() : "",
                      code  = v.TryGetProperty("code",  out var vc) ? vc.GetString() : ""
                    }).ToList()
                  : new List<dynamic>() as dynamic;
              var cvLetters = new[] { "A", "B", "C" };
              <div class="lb lb-quiz" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-quiz-header">
                  <span class="lb-quiz-badge">сравнение</span>
                  <span class="lb-quiz-q">@cvQ</span>
                </div>
                <div class="lb-quiz-opts">
                  @for (int ci = 0; ci < cvVariants.Count; ci++) {
                    var cv = cvVariants[ci];
                    <button class="lb-quiz-opt" style="flex-direction:column;align-items:flex-start;gap:8px"
                            data-letter="@(ci < cvLetters.Length ? cvLetters[ci] : (ci+1).ToString())"
                            data-idx="@ci" onclick="selectQuizOpt(this)">
                      <span style="font-size:8px;color:#888">@cv.title</span>
                      <pre style="margin:0;white-space:pre-wrap"><code class="language-csharp">@cv.code</code></pre>
                    </button>
                  }
                </div>
                <button class="lb-quiz-submit" onclick="submitQuiz(this)">Подтвердить</button>
                @if (!string.IsNullOrEmpty(cvExpl)) { <div class="lb-quiz-expl" style="display:none">@cvExpl</div> }
              </div>
            }

            @* ── ДВА ПУТИ ─────────────────────────────────────────────────────── *@
            else if (block.Type == "two_path")
            {
              var tpQ      = content.TryGetProperty("question",   out var tpq) ? tpq.GetString() : "";
              var tpConc   = content.TryGetProperty("conclusion", out var tpc) ? tpc.GetString() : "";
              var tpExpl   = content.TryGetProperty("explanation",out var tpe) ? tpe.GetString() : tpConc;
              var tpLang   = (blockLang == "python") ? "python" : "csharp";
              var tpA = content.TryGetProperty("pathA", out var pA) ? new {
                  title = pA.TryGetProperty("title", out var at)  ? at.GetString() : "Путь A",
                  code  = pA.TryGetProperty("code",  out var ac)  ? ac.GetString() : "",
                  pros  = pA.TryGetProperty("pros",  out var apr) ? apr.GetString() : "",
                  cons  = pA.TryGetProperty("cons",  out var aco) ? aco.GetString() : "" } : null;
              var tpB = content.TryGetProperty("pathB", out var pB) ? new {
                  title = pB.TryGetProperty("title", out var bt2) ? bt2.GetString() : "Путь B",
                  code  = pB.TryGetProperty("code",  out var bc)  ? bc.GetString()  : "",
                  pros  = pB.TryGetProperty("pros",  out var bpr) ? bpr.GetString() : "",
                  cons  = pB.TryGetProperty("cons",  out var bco) ? bco.GetString() : "" } : null;
              <div class="lb lb-text" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-type-tag">два пути</div>
                <div class="lb-twop-question">@tpQ</div>
                <div class="lb-twop-grid">
                  @if (tpA != null) {
                    <div class="lb-twop-col">
                      <div class="lb-twop-col-title">@tpA.title</div>
                      <div class="lb-code-ace-view" data-lang="@tpLang"></div>
                      <pre class="lb-code-src" style="display:none">@tpA.code</pre>
                      @if (!string.IsNullOrEmpty(tpA.pros)) {
                        <div class="lb-twop-meta lb-twop-pros">✓ @tpA.pros</div>
                      }
                      @if (!string.IsNullOrEmpty(tpA.cons)) {
                        <div class="lb-twop-meta lb-twop-cons">✗ @tpA.cons</div>
                      }
                    </div>
                  }
                  @if (tpB != null) {
                    <div class="lb-twop-col">
                      <div class="lb-twop-col-title">@tpB.title</div>
                      <div class="lb-code-ace-view" data-lang="@tpLang"></div>
                      <pre class="lb-code-src" style="display:none">@tpB.code</pre>
                      @if (!string.IsNullOrEmpty(tpB.pros)) {
                        <div class="lb-twop-meta lb-twop-pros">✓ @tpB.pros</div>
                      }
                      @if (!string.IsNullOrEmpty(tpB.cons)) {
                        <div class="lb-twop-meta lb-twop-cons">✗ @tpB.cons</div>
                      }
                    </div>
                  }
                </div>
                @if (!string.IsNullOrEmpty(tpExpl)) {
                  <div class="lb-twop-conclusion">→ @tpExpl</div>
                }
                @if (!alreadyDone) {
                  <div class="lb-continue">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

            @* ── ЧТО ЕСЛИ ─────────────────────────────────────────────────────── *@
            else if (block.Type == "counterfactual")
            {
              var cfCode   = content.TryGetProperty("code",       out var cfc) ? cfc.GetString() : "";
              var cfLine   = content.TryGetProperty("removeLine", out var cfl) ? cfl.GetInt32()  : 1;
              var cfQ      = content.TryGetProperty("question",   out var cfq) ? cfq.GetString() : $"Что если убрать строку {cfLine}?";
              var cfAnswer = content.TryGetProperty("answer",     out var cfa) ? cfa.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">что если</span>
                  <span class="lb-task-title">@cfQ</span>
                </div>
                <pre class="lb-code-pre" style="border-bottom:2px solid #1a1a1a"><code class="language-csharp">@cfCode</code></pre>
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Твой ответ..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ПО ЧАСТЯМ ────────────────────────────────────────────────────── *@
            else if (block.Type == "progressive_reveal")
            {
              var prTitle = content.TryGetProperty("title",          out var prt) ? prt.GetString() : "";
              var prHints = content.TryGetProperty("hints",          out var prh)
                  ? prh.EnumerateArray().Select(h => h.GetString()).ToList() : new List<string?>();
              var prFinal = content.TryGetProperty("finalCode",      out var prf) ? prf.GetString() : "";
              var prExp   = content.TryGetProperty("expectedOutput", out var pre) ? pre.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id"
                   data-hints="@string.Join("|||", prHints)" data-final-code="@prFinal" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">по частям</span>
                  <span class="lb-task-title">@prTitle</span>
                </div>
                <div class="lb-progressive-hints" style="padding:0"></div>
                <div class="lb-task-footer" style="border-top:2px solid #1a1a1a;margin-top:0">
                  <button class="lb-btn secondary" onclick="revealNextHint(this)">▶ Следующая подсказка</button>
                  <button class="lb-btn" onclick="checkTask(this)" style="display:none">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
                <textarea class="lb-task-input" spellcheck="false" style="display:none"></textarea>
              </div>
            }

            @* ── СМЫСЛ-ДИФ ───────────────────────────────────────────────────── *@
            else if (block.Type == "semantic_diff")
            {
              var sdIntended = content.TryGetProperty("intendedCode", out var sdi) ? sdi.GetString() : "";
              var sdActual   = content.TryGetProperty("actualCode",   out var sda) ? sda.GetString() : "";
              var sdExpl     = content.TryGetProperty("explanation",  out var sde) ? sde.GetString() : "";
              <div class="lb lb-text" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-type-tag">смысл-диф</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border:2px solid #222;margin-bottom:12px">
                  <div style="border-right:2px solid #222">
                    <div style="padding:6px 12px;font-size:7px;color:#4caf50;letter-spacing:2px;border-bottom:1px solid #222">Хотел написать</div>
                    <pre style="margin:0;padding:12px;background:#060606"><code class="language-csharp">@sdIntended</code></pre>
                  </div>
                  <div>
                    <div style="padding:6px 12px;font-size:7px;color:#ff4444;letter-spacing:2px;border-bottom:1px solid #222">Написал на самом деле</div>
                    <pre style="margin:0;padding:12px;background:#060606"><code class="language-csharp">@sdActual</code></pre>
                  </div>
                </div>
                @if (!string.IsNullOrEmpty(sdExpl)) { <div style="font-size:9px;color:#777;padding-top:8px">@sdExpl</div> }
                @if (!alreadyDone) {
                  <div class="lb-continue">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

            @* ── КОНТРПРИМЕР / СЛОМАЙ ─────────────────────────────────────────── *@
            else if (block.Type == "counterexample" || block.Type == "adversarial_test")
            {
              var ceCode  = content.TryGetProperty("code",        out var cec) ? cec.GetString() : "";
              var ceClaim = content.TryGetProperty("claim",       out var cel) ? cel.GetString() : "";
              var ceAns   = content.TryGetProperty("answer",      out var cea) ? cea.GetString() : "";
              var ceHint  = content.TryGetProperty("hint",        out var ceh) ? ceh.GetString() : "";
              var ceExpl  = content.TryGetProperty("explanation", out var cee) ? cee.GetString() : "";
              var ceBadge = block.Type == "adversarial_test" ? "сломай" : "контрпример";
              var ceTitle = block.Type == "adversarial_test"
                  ? "Придумай вход, на котором код сломается"
                  : "Найди вход, на котором утверждение ложно";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">@ceBadge</span>
                  <span class="lb-task-title">@ceTitle</span>
                </div>
                @if (!string.IsNullOrEmpty(ceCode))  { <pre class="lb-code-pre" style="border-bottom:2px solid #1a1a1a"><code class="language-csharp">@ceCode</code></pre> }
                @if (!string.IsNullOrEmpty(ceClaim)) { <div class="lb-task-desc">Утверждение: <strong>@ceClaim</strong></div> }
                @if (!string.IsNullOrEmpty(ceHint))  { <div class="lb-task-hint">@ceHint</div> }
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Введи вход, который ломает утверждение..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
                @if (!string.IsNullOrEmpty(ceExpl)) { <div class="lb-quiz-expl" style="display:none">@ceExpl</div> }
              </div>
            }

            @* ── ОТ ЦЕЛИ / С НУЛЯ / ОГРАНИЧЕНИЕ / КОНТР. ЗАДАЧА ─────────────── *@
            else if (block.Type == "goal_construction" || block.Type == "rebuild_scratch" ||
                     block.Type == "constraint"        || block.Type == "control_task")
            {
              var gcTitle   = content.TryGetProperty("title",          out var gct) ? gct.GetString() : "";
              var gcDesc    = content.TryGetProperty("description",    out var gcd) ? gcd.GetString() : "";
              var gcGoal    = content.TryGetProperty("goal",           out var gcg) ? gcg.GetString() : "";
              var gcConst   = content.TryGetProperty("constraint",     out var gcc) ? gcc.GetString() : "";
              var gcStarter = content.TryGetProperty("starterCode",    out var gcs) ? gcs.GetString() : "";
              var gcExp     = content.TryGetProperty("expectedOutput", out var gce) ? gce.GetString() : "";
              var gcHint    = content.TryGetProperty("hint",           out var gch) ? gch.GetString() : "";
              var gcBadge   = block.Type switch {
                "constraint"     => "ограничение",
                "rebuild_scratch"=> "с нуля",
                "control_task"   => "контроль",
                _                => "от цели"
              };
              var gcHeader = string.IsNullOrEmpty(gcTitle) ? (string.IsNullOrEmpty(gcGoal) ? "Задача" : gcGoal) : gcTitle;
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@gcStarter" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">@gcBadge</span>
                  <span class="lb-task-title">@gcHeader</span>
                </div>
                @if (!string.IsNullOrEmpty(gcDesc))  { <div class="lb-task-desc">@gcDesc</div> }
                @if (!string.IsNullOrEmpty(gcConst)) { <div class="lb-task-hint">⛔ Ограничение: @gcConst</div> }
                @if (!string.IsNullOrEmpty(gcHint))  { <div class="lb-task-hint">@gcHint</div> }
                <textarea class="lb-task-input" spellcheck="false">@gcStarter</textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── МУТАЦИЯ ──────────────────────────────────────────────────────── *@
            else if (block.Type == "mutation")
            {
              var mutBase = content.TryGetProperty("baseCode",       out var mbc) ? mbc.GetString() : "";
              var mutMut  = content.TryGetProperty("mutation",       out var mmt) ? mmt.GetString() : "";
              var mutExp  = content.TryGetProperty("expectedOutput", out var mme) ? mme.GetString() : "";
              var mutHint = content.TryGetProperty("hint",           out var mmh) ? mmh.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@mutBase" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">мутация</span>
                  <span class="lb-task-title">Адаптируй код под новые условия</span>
                </div>
                <div class="lb-task-desc">Изменение: <strong>@mutMut</strong></div>
                @if (!string.IsNullOrEmpty(mutHint)) { <div class="lb-task-hint">@mutHint</div> }
                <textarea class="lb-task-input" spellcheck="false">@mutBase</textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

             @* ── ФУНКЦИЯ С ТЕСТАМИ ────────────────────────────────────────────── *@
            else if (block.Type == "func_task")
            {
              var ftTitle = content.TryGetProperty("title",        out var ftt) ? ftt.GetString() : "Задача";
              var ftDesc  = content.TryGetProperty("description",  out var ftd) ? ftd.GetString() : "";
              var ftCode  = content.TryGetProperty("starterCode",  out var ftc) ? ftc.GetString() : "";
              var ftTest  = content.TryGetProperty("testCode",     out var fte) ? fte.GetString() : "";
              var ftHint  = content.TryGetProperty("hint",         out var fth) ? fth.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-language="@blockLang" data-run="true" data-test-code="@ftTest" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">функция</span>
                  <span class="lb-task-title">@ftTitle</span>
                </div>
                @if (!string.IsNullOrEmpty(ftDesc)) { <div class="lb-task-desc">@ftDesc</div> }
                @if (!string.IsNullOrEmpty(ftHint)) { <div class="lb-task-hint">@ftHint</div> }
                <textarea class="lb-task-input" spellcheck="false">@ftCode</textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkFuncTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

             @* ── ЧЕКПОИНТ ─────────────────────────────────────────────────────── *@
            else if (block.Type == "checkpoint")
            {
              var cpTitle = content.TryGetProperty("title",       out var cpt) ? cpt.GetString() : "Чекпоинт";
              var cpDesc  = content.TryGetProperty("description", out var cpd) ? cpd.GetString() : "";
              var cpTasks = content.TryGetProperty("tasks",       out var cptasks)
                  ? cptasks.EnumerateArray().Select(t => t.GetString()).ToList() : new List<string?>();
              <div class="lb lb-text" data-block-idx="@blockIdx" style="@hiddenStyle">
                <div class="lb-type-tag">чекпоинт</div>
                <div style="font-size:10px;color:#fff;margin-bottom:8px">⬛ @cpTitle</div>
                @if (!string.IsNullOrEmpty(cpDesc)) { <div style="font-size:9px;color:#777;margin-bottom:12px">@cpDesc</div> }
                @if (cpTasks.Any()) {
                  <div style="display:flex;flex-direction:column;gap:6px">
                    @for (int cpi = 0; cpi < cpTasks.Count; cpi++) {
                      <div style="font-size:9px;color:#ccc;padding:8px 12px;border:1px solid #222;letter-spacing:1px">
                        @(cpi + 1). @cpTasks[cpi]
                      </div>
                    }
                  </div>
                }
                @if (!alreadyDone) {
                  <div class="lb-continue" style="margin-top:12px">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

            @* ── ПОРЯДОК ──────────────────────────────────────────────────────── *@
            else if (block.Type == "drag_order")
            {
              var dopieces   = content.TryGetProperty("pieces",   out var dop)
                  ? dop.EnumerateArray().Select(p => p.GetString()).ToList() : new List<string?>();
              var doSolution = content.TryGetProperty("solution", out var dos)
                  ? dos.EnumerateArray().Select(s => s.GetInt32()).ToList() : new List<int>();
              var doHint     = content.TryGetProperty("hint",     out var doh) ? doh.GetString() : "";
              var doIndentByPiece = new Dictionary<int, int>();
              var doDepth = 0;
              foreach (var pieceIdx in doSolution)
              {
                var pieceText = pieceIdx >= 0 && pieceIdx < dopieces.Count ? (dopieces[pieceIdx] ?? "").Trim() : "";
                if (pieceText.StartsWith("}")) { doDepth = Math.Max(0, doDepth - 1); }
                doIndentByPiece[pieceIdx] = doDepth;
                if (pieceText.EndsWith("{")) { doDepth++; }
              }
              <div class="lb lb-drag-order" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">порядок</span>
                  <span class="lb-task-title">Расставь блоки кода в правильном порядке</span>
                </div>
                @if (!string.IsNullOrEmpty(doHint)) { <div class="lb-task-hint">@doHint</div> }
                <div class="lb-drag-area">
                  @for (int dpi = 0; dpi < dopieces.Count; dpi++) {
                    var doIndent = doIndentByPiece.TryGetValue(dpi, out var level) ? level : 0;
                    <div class="lb-drag-piece" draggable="true" data-orig-idx="@dpi"
                         style="--indent-level:@doIndent">
                      <span class="lb-drag-grip" aria-hidden="true">::</span>
                      <code class="lb-drag-code">@dopieces[dpi]</code>
                    </div>
                  }
                </div>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkDragOrder(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── КОД → СМЫСЛ ─────────────────────────────────────────────────── *@
            else if (block.Type == "code_to_intent")
            {
              var ctiCode    = content.TryGetProperty("code",          out var ctc)   ? ctc.GetString()   : "";
              var ctiOpts    = content.TryGetProperty("options",       out var cto)
                  ? cto.EnumerateArray().Select(o => o.GetString()).ToList() : new List<string?>();
              var ctiCorrect = content.TryGetProperty("correctIntent", out var ctcor) ? ctcor.GetInt32()  : 0;
              var ctiLetters = new[] { "A", "B", "C", "D" };
              <div class="lb lb-quiz" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-quiz-header">
                  <span class="lb-quiz-badge">код→смысл</span>
                  <span class="lb-quiz-q">Что делает этот код?</span>
                </div>
                <pre class="lb-code-pre" style="margin-bottom:12px"><code class="language-csharp">@ctiCode</code></pre>
                <div class="lb-quiz-opts" style="padding:0 0 4px">
                  @for (int cti = 0; cti < ctiOpts.Count; cti++) {
                    <button class="lb-quiz-opt"
                            data-letter="@(cti < ctiLetters.Length ? ctiLetters[cti] : (cti+1).ToString())"
                            data-idx="@cti" onclick="selectQuizOpt(this)">@ctiOpts[cti]</button>
                  }
                </div>
                <button class="lb-quiz-submit" onclick="submitQuiz(this)">Подтвердить</button>
              </div>
            }

            @* ── ШАБЛОН ───────────────────────────────────────────────────────── *@
            else if (block.Type == "template_completion")
            {
              var tcTemplate = content.TryGetProperty("template", out var tct) ? tct.GetString() : "";
              var tcBlanks   = content.TryGetProperty("blanks",   out var tcb)
                  ? tcb.EnumerateArray().Select(b => b.GetString()).ToList() : new List<string?>();
              var tcHint     = content.TryGetProperty("hint",     out var tch) ? tch.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">шаблон</span>
                  <span class="lb-task-title">Дополни шаблон</span>
                </div>
                @if (!string.IsNullOrEmpty(tcHint)) { <div class="lb-task-desc">@tcHint</div> }
                @{
                  var tcParts = tcTemplate!.Split("___");
                  var tcSb = new System.Text.StringBuilder();
                  for (int tci = 0; tci < tcParts.Length; tci++) {
                    tcSb.Append("<span class=\"fb-part\">");
                    tcSb.Append(System.Net.WebUtility.HtmlEncode(tcParts[tci]));
                    tcSb.Append("</span>");
                    if (tci < tcParts.Length - 1) {
                      var tcAnsLen = tci < tcBlanks.Count ? (tcBlanks[tci]?.Length ?? 5) : 5;
                      var tcW = Math.Max(60, tcAnsLen * 11);
                      tcSb.Append($"<input class=\"lb-blank-input\" type=\"text\" data-blank-idx=\"{tci}\" style=\"width:{tcW}px\" spellcheck=\"false\">");
                    }
                  }
                }
                <div class="lb-fill-blank-area">@Html.Raw(tcSb.ToString())</div>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkFillBlank(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── СКРЫТЫЙ БАГ ──────────────────────────────────────────────────── *@
            else if (block.Type == "broken_reality")
            {
              var brCode = content.TryGetProperty("code",           out var brc) ? brc.GetString() : "";
              var brEdge = content.TryGetProperty("edgeCaseInput",  out var bre) ? bre.GetString() : "";
              var brDesc = content.TryGetProperty("bugDescription", out var brd) ? brd.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">скрытый баг</span>
                  <span class="lb-task-title">Найди вход, на котором код сломается</span>
                </div>
                <pre class="lb-code-pre" style="border-bottom:2px solid #1a1a1a"><code class="language-csharp">@brCode</code></pre>
                @if (!string.IsNullOrEmpty(brDesc)) { <div class="lb-task-desc">@brDesc</div> }
                <textarea class="lb-task-input" spellcheck="false" style="min-height:60px" placeholder="Введи проблемный входной аргумент..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkTask(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── ИСПЫТАНИЕ ────────────────────────────────────────────────────── *@
            else if (block.Type == "challenge_task")
            {
              var chTitle   = content.TryGetProperty("title",          out var cht) ? cht.GetString() : "Финальное испытание";
              var chDesc    = content.TryGetProperty("description",    out var chd) ? chd.GetString() : "";
              var chReqs    = content.TryGetProperty("requirements",   out var chr)
                  ? chr.EnumerateArray().Select(r => r.GetString()).ToList() : new List<string?>();
              var chStarter = content.TryGetProperty("starterCode",    out var chs) ? chs.GetString() : "";
              var chExp     = content.TryGetProperty("expectedOutput", out var che) ? che.GetString() : "";
              <div class="lb lb-challenge" data-block-idx="@blockIdx" data-block-id="@block.Id" data-language="@blockLang" data-run="true" data-starter="@chStarter" style="@hiddenStyle">
                <!-- Trophy header -->
                <div class="lb-challenge-header">
                  <div class="lb-challenge-trophy">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" shape-rendering="crispEdges" fill="none">
                      <rect fill="#ffd700" x="18" y="42" width="12" height="4"/>
                      <rect fill="#ffd700" x="14" y="40" width="20" height="2"/>
                      <rect fill="#ffd700" opacity=".8" x="10" y="16" width="28" height="22"/>
                      <rect fill="#000" opacity=".4" x="12" y="18" width="24" height="18"/>
                      <rect fill="#fff" opacity=".18" x="12" y="18" width="4" height="18"/>
                      <rect fill="#fff" opacity=".18" x="12" y="18" width="24" height="3"/>
                      <rect fill="#ffd700" opacity=".8" x="6" y="18" width="4" height="12"/>
                      <rect fill="#ffd700" opacity=".8" x="38" y="18" width="4" height="12"/>
                      <rect fill="#ffd700" x="8" y="14" width="32" height="2"/>
                      <rect fill="#fff" opacity=".9" x="22" y="22" width="4" height="4"/>
                      <rect fill="#fff" opacity=".9" x="20" y="24" width="8" height="2"/>
                      <rect fill="#fff" opacity=".9" x="18" y="26" width="12" height="2"/>
                      <rect fill="#fff" opacity=".9" x="20" y="28" width="8" height="2"/>
                      <rect fill="#fff" opacity=".9" x="22" y="30" width="4" height="2"/>
                    </svg>
                  </div>
                  <div class="lb-challenge-title-block">
                    <div class="lb-challenge-badge">ИСПЫТАНИЕ</div>
                    <div class="lb-challenge-title">@chTitle</div>
                  </div>
                </div>
                @if (!string.IsNullOrEmpty(chDesc)) {
                  <div class="lb-challenge-desc">@chDesc</div>
                }
                @if (chReqs.Any()) {
                  <div class="lb-challenge-reqs">
                    <div class="lb-challenge-reqs-title">Требования:</div>
                    @for (int ri = 0; ri < chReqs.Count; ri++) {
                      <div class="lb-challenge-req-item">
                        <span class="lb-challenge-req-num">@(ri + 1).</span>
                        <span>@chReqs[ri]</span>
                      </div>
                    }
                  </div>
                }
                <textarea class="lb-task-input lb-challenge-editor" spellcheck="false">@chStarter</textarea>
                <div class="lb-task-footer lb-challenge-footer">
                  <button class="lb-btn lb-challenge-btn" onclick="checkChallenge(this)">▶ Запустить и проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetCode(this)" title="Сбросить до исходного кода">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── КОРОТКИЙ ОТВЕТ ───────────────────────────────────────────────── *@
            else if (block.Type == "short_answer")
            {
              var saQ    = content.TryGetProperty("question", out var saq) ? saq.GetString() : "";
              var saAns  = content.TryGetProperty("answer",   out var saa) ? saa.GetString() : "";
              var saHint = content.TryGetProperty("hint",     out var sah) ? sah.GetString() : "";
              <div class="lb lb-task" data-block-idx="@blockIdx" data-block-id="@block.Id" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">ввод</span>
                  <span class="lb-task-title">@saQ</span>
                </div>
                @if (!string.IsNullOrEmpty(saHint)) { <div class="lb-task-desc" style="font-style:italic;color:#555">Подсказка: @saHint</div> }
                <textarea class="lb-task-input" spellcheck="false" style="min-height:52px" placeholder="Введи ответ..."></textarea>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkShortAnswer(this)">Проверить</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── КЛАССИФИКАЦИЯ ────────────────────────────────────────────────── *@
            else if (block.Type == "classify")
            {
              var clPrompt = content.TryGetProperty("instruction", out var _clInstr) ? _clInstr.GetString()
                           : content.TryGetProperty("prompt", out var _clPrmt) ? _clPrmt.GetString() : "Классифицируй";
              var clCats   = content.TryGetProperty("categories", out var clc)
                  ? clc.EnumerateArray().Select(x => x.GetString()).ToList() : new List<string?>();
              List<string?> clItems;
              string clAns;
              if (content.TryGetProperty("items", out var _clItemsEl) && _clItemsEl.ValueKind == JsonValueKind.Array)
              {
                  var _clFirst = _clItemsEl.EnumerateArray().FirstOrDefault();
                  if (_clFirst.ValueKind == JsonValueKind.Object)
                  {
                      clItems = _clItemsEl.EnumerateArray()
                          .Select(x => x.TryGetProperty("text", out var _t) ? _t.GetString() : null).ToList();
                      var _clAnsDict = _clItemsEl.EnumerateArray()
                          .Where(x => x.TryGetProperty("text", out _) && x.TryGetProperty("category", out _))
                          .ToDictionary(
                              x => x.GetProperty("text").GetString() ?? "",
                              x => x.GetProperty("category").GetString() ?? "");
                      clAns = JsonSerializer.Serialize(_clAnsDict);
                  }
                  else
                  {
                      clItems = _clItemsEl.EnumerateArray().Select(x => x.GetString()).ToList();
                      clAns = content.TryGetProperty("answer", out var _cla1) ? _cla1.GetString() ?? "{}" : "{}";
                  }
              }
              else
              {
                  clItems = new List<string?>();
                  clAns = content.TryGetProperty("answer", out var _cla2) ? _cla2.GetString() ?? "{}" : "{}";
              }
              <div class="lb lb-classify" data-block-idx="@blockIdx" data-answer="@clAns" style="@hiddenStyle">
                <div class="lb-task-header">
                  <span class="lb-task-badge">классификация</span>
                  <span class="lb-task-title">@clPrompt</span>
                </div>
                <div class="lb-classify-body">
                  <div class="lb-classify-items" id="clItems_@blockIdx">
                    @foreach (var item in clItems.Where(i => !string.IsNullOrEmpty(i))) {
                      <span class="lb-classify-chip" draggable="true" data-item="@item">@item</span>
                    }
                  </div>
                  <div class="lb-classify-cats">
                    @foreach (var cat in clCats.Where(c => !string.IsNullOrEmpty(c))) {
                      <div class="lb-classify-cat" data-cat="@cat">
                        <div class="lb-classify-cat-label">@cat</div>
                        <div class="lb-classify-drop" ondragover="event.preventDefault()" ondrop="classifyDrop(event,this)"></div>
                      </div>
                    }
                  </div>
                </div>
                <div class="lb-task-footer">
                  <button class="lb-btn" onclick="checkClassify(this)">Проверить</button>
                  <button class="lb-btn lb-reset-btn" onclick="resetClassify(this)" title="Сбросить">↺</button>
                  <span class="lb-task-result"></span>
                </div>
              </div>
            }

            @* ── НЕИЗВЕСТНЫЙ ТИП ──────────────────────────────────────────────── *@
            else
            {
              <div class="lb lb-text" data-block-idx="@blockIdx" style="@hiddenStyle;color:#555;font-size:8px">
                [Тип блока: @block.Type]
                @if (!alreadyDone) {
                  <div class="lb-continue">
                    <button class="lb-btn secondary" onclick="completeBlock(this)">Далее →</button>
                  </div>
                }
              </div>
            }

          }

          <!-- Экран завершения урока -->
          <div class="lesson-complete" id="lessonComplete"
               style="@(alreadyDone ? "" : "display:none")">
            <div class="lesson-complete-icon">✓</div>
            <div class="lesson-complete-text">Урок пройден!<br>Продолжай в том же духе</div>
            @if (Model.Module != null)
            {
              <a asp-controller="Course" asp-action="Index" asp-route-id="@Model.ModuleId"
                 class="lesson-complete-btn">← Вернуться к модулю</a>
            }
            else
            {
              <a asp-controller="Main" asp-action="Index"
                 class="lesson-complete-btn">← На карту</a>
            }
            <button class="lesson-complete-btn lesson-reset-btn" onclick="resetLesson()">↺ Перепройти</button>
          </div>

        </div><!-- /lesson-blocks -->
      </div><!-- /panel-body -->
    </div><!-- /px-panel -->

    <!-- ══════════════════════════════════════════════════
         ЧАТ УРОКА
    ══════════════════════════════════════════════════ -->
    <div class="lesson-chat" id="lessonChat">
      <!-- Вкладки -->
      <div class="lc-tabs">
        <button class="lc-tab lc-tab--active" id="tabDiscuss" onclick="switchTab('discuss')">
