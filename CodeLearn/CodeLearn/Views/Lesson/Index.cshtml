<script>
  // Подсвечиваем ВСЕ блоки кода (теория, предсказание, сравнение, баги и т.д.)
  document.querySelectorAll('pre code').forEach(function(el) {
    try { hljs.highlightElement(el); } catch (e) {}
  });
</script>

<!-- Ace Editor (редактор кода для задач) -->
<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/ace.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/mode-csharp.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/mode-python.js"></script>
<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/theme-tomorrow_night_bright.js"></script>
<script src="~/js/lesson/effects.js" asp-append-version="true"></script>
<script>
// ══════════════════════════════════════════════════════════════════
//  ПРОГРЕССИЯ БЛОКОВ
// ══════════════════════════════════════════════════════════════════
var TOTAL        = @blockCount;
var LESSON_ID    = @Model.Id;
var ALREADY_DONE = @(alreadyDone ? "true" : "false");
var INITIAL_COMPLETED = @savedCompletedBlocks;
var LESSON_LANG  = '@defaultLang';   // fallback язык курса
var completed    = INITIAL_COMPLETED;

// Инициализация прогресс-бара
(function () {
  if (ALREADY_DONE && TOTAL > 0) {
    document.getElementById('lpFill').style.width = '100%';
  }
  restoreSavedProgress();
  if (!ALREADY_DONE && TOTAL > 0 && INITIAL_COMPLETED >= TOTAL) {
    showComplete();
    return;
  }
  // Если блоков нет и урок ещё не пройден — сразу завершаем
  if (TOTAL === 0 && !ALREADY_DONE) { showComplete(); }
})();

function restoreSavedProgress() {
  if (INITIAL_COMPLETED <= 0 || ALREADY_DONE) return;
  document.querySelectorAll('.lb[data-block-idx]').forEach(function (block) {
    var idx = parseInt(block.dataset.blockIdx, 10);
    if (idx < INITIAL_COMPLETED) {
      block.style.display = '';
      block.classList.add('lb--done');
      block.querySelectorAll('button, input, textarea').forEach(function (control) {
        control.disabled = true;
      });
      if (block._aceEditor) block._aceEditor.setReadOnly(true);
    } else if (idx === INITIAL_COMPLETED) {
      block.style.display = '';
    }
  });
}

/* Перейти к следующему блоку после завершения текущего */
function completeBlock(source) {
  if (ALREADY_DONE) return;   // урок уже пройден, прогрессия не нужна
  if (completed >= TOTAL) return;

  // Найти родительский блок
  var block = (source && source.closest)
    ? source.closest('.lb[data-block-idx]')
    : null;
  if (!block) return;
  if (block.classList.contains('lb--done')) return;

  // Пометить как выполненный
  block.classList.add('lb--done');
  completed++;

  // Обновить прогресс-бар
  var pct = Math.round(completed / TOTAL * 100);
  document.getElementById('lpFill').style.width = pct + '%';
  document.getElementById('lpSteps').textContent =
    'блок ' + completed + ' из ' + TOTAL;
  saveLessonProgress(completed);

  // Показать следующий блок
  var idx  = parseInt(block.dataset.blockIdx);
  var next = document.querySelector('.lb[data-block-idx="' + (idx + 1) + '"]');
  if (next) {
    next.style.display = '';
    void next.offsetWidth;          // форс reflow для анимации
    next.classList.add('lb--reveal');
    setTimeout(function () {
      next.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 80);
  } else {
    // Последний блок — показать экран завершения
    showComplete();
  }
}

function saveLessonProgress(count) {
  if (ALREADY_DONE) return;
  fetch('/Lesson/Progress/' + LESSON_ID, {
    method: 'POST',
    keepalive: true,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ completedBlocks: count })
  }).catch(function () {});
}

/* Пул общих подсказок для блоков без явного hint-текста */
var GENERIC_HINTS = [
  'Перечитай условие задачи — возможно, ты упустил детали.',
  'Обрати внимание на регистр: C# чувствителен к Is/is, String/string.',
  'Попробуй запустить код через «Запустить» и посмотреть на реальный вывод.',
  'Проверь пробелы и переносы строк — они влияют на вывод.',
  'Сравни свой вывод с примером символ за символом.',
  'Проверь точки с запятой, скобки и кавычки.',
  'Попробуй упростить решение — иногда лишний код мешает.',
  'Вернись к теории в предыдущих блоках — ответ там.',
];
var _hintToastTimer = null;

function showHintToast(text) {
  // Убрать предыдущий тост
  var old = document.querySelector('.lb-hint-toast');
  if (old) old.remove();
  if (_hintToastTimer) clearTimeout(_hintToastTimer);

  var toast = document.createElement('div');
  toast.className = 'lb-hint-toast';
  toast.textContent = text;
  document.body.appendChild(toast);

  _hintToastTimer = setTimeout(function() {
    toast.classList.add('lb-hint-toast--out');
    setTimeout(function() { toast.remove(); }, 420);
  }, 5500);
}

/* Тряска блока + логика подсказок (показ после 3 ошибок на одном блоке) */
var HINT_THRESHOLD = 3;   // сколько ошибок до появления подсказки

function shakeBlock(el) {
  var b = el && el.closest ? el.closest('.lb') : el;
  if (!b) return;
  b.classList.remove('lb--shake');
  void b.offsetWidth;
  b.classList.add('lb--shake');
  setTimeout(function () { b.classList.remove('lb--shake'); }, 500);

  // Счётчик ошибок на блоке
  b._localErrors = (b._localErrors || 0) + 1;

  if (b._localErrors >= HINT_THRESHOLD) {
    // Есть встроенный хинт — показать его
    var hintEl = b.querySelector('.lb-task-hint');
    if (hintEl && !hintEl.classList.contains('lb-hint--show')) {
      hintEl.classList.add('lb-hint--show');
      hintEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else if (!hintEl) {
      // Нет явного хинта — показать тост с общей подсказкой
      var genericIdx = Math.floor(Math.random() * GENERIC_HINTS.length);
      showHintToast(GENERIC_HINTS[genericIdx]);
    }
  }

  recordError();
}

/* Фиксация ошибки на сервере и обновление бейджа */
function recordError() {
  fetch('/Lesson/AddError?id=@Model.Id', { method: 'POST' })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(data) {
      if (!data) return;
      var badge = document.getElementById('errorBadge');
      var cnt   = document.getElementById('errorCount');
      cnt.textContent = data.lessonErrors;
      badge.classList.remove('err-bump');
      void badge.offsetWidth;
      badge.classList.add('err-bump');
    })
    .catch(function() {});
}

/* Экран завершения урока */
function showComplete() {
  document.getElementById('lpFill').style.width = '100%';
  document.getElementById('lpSteps').textContent = 'урок завершён ✓';
  var c = document.getElementById('lessonComplete');
  c.style.display = 'flex';
  void c.offsetWidth;
  c.classList.add('lb--reveal');
  setTimeout(function () {
    c.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
  // Отправить факт прохождения на сервер
  csrfFetch('/Lesson/Complete/' + LESSON_ID, { method: 'POST' }).catch(function () {});
}

// ══════════════════════════════════════════════════════════════════
//  ACE EDITOR + КОМПИЛЯТОР
// ══════════════════════════════════════════════════════════════════

(function initCodeEditors() {
  if (typeof ace === 'undefined') return;
  ace.config.set('basePath', 'https://cdn.jsdelivr.net/npm/ace-builds@1.32.6/src-min-noconflict/');

  // Только блоки с data-run="true" — student пишет/правит код
  document.querySelectorAll('.lb[data-run]').forEach(function (block) {
    var lang = (block.dataset.language || LESSON_LANG || 'csharp').trim();

    var textarea = block.querySelector('.lb-task-input');
    if (!textarea) return;

    // Обёртка + редактор
    var wrap = document.createElement('div');
    wrap.className = 'lb-editor-wrap';
    var edDiv = document.createElement('div');
    edDiv.className = 'lb-ace-editor';
    wrap.appendChild(edDiv);
    textarea.parentNode.insertBefore(wrap, textarea);
    textarea.style.display = 'none';

    var editor = ace.edit(edDiv);
    editor.setTheme('ace/theme/tomorrow_night_bright');
    editor.session.setMode('ace/mode/' + lang);
    editor.setValue(textarea.value || '', -1);
    editor.setOptions({
      fontSize: '14px', fontFamily: "'Courier New', monospace",
      showPrintMargin: false, highlightActiveLine: true,
      tabSize: 4, useSoftTabs: true, wrap: false
    });
    resizeCodeEditor(editor, edDiv);
    editor.session.on('change', function () {
      resizeCodeEditor(editor, edDiv);
    });
    editor.resize();
    block._aceEditor = editor;
    if (block.classList.contains('lb--done')) {
      editor.setReadOnly(true);
    }

    // Панель вывода
    var panel = document.createElement('div');
    panel.className = 'lb-output';
    panel.style.display = 'none';
    panel.innerHTML =
      '<div class="lb-output-header">' +
      '<span class="lb-output-label">OUTPUT</span>' +
      '<span class="lb-output-ms"></span></div>' +
      '<pre class="lb-output-content"></pre>';
    var footer = block.querySelector('.lb-task-footer');
    if (footer) block.insertBefore(panel, footer);

    // Кнопка запуска — не добавляем для challenge-блоков (у них своя кнопка checkChallenge)
    if (footer && !block.classList.contains('lb-challenge')) {
      var runBtn = document.createElement('button');
      runBtn.className = 'lb-btn lb-run-btn';
      runBtn.innerHTML = '&#9654; Запустить';
      runBtn.onclick = function () { runCode(runBtn); };
      runBtn.disabled = block.classList.contains('lb--done');
      footer.insertBefore(runBtn, footer.firstChild);
    }

    // Бейдж языка
    var hdr = block.querySelector('.lb-task-header');
    if (hdr) {
      var badge = document.createElement('span');
      badge.className = 'lb-lang-badge lb-lang-badge--' + lang;
      badge.textContent = lang === 'csharp' ? 'C#' : lang.charAt(0).toUpperCase() + lang.slice(1);
      hdr.appendChild(badge);
    }
  });
})();

function resizeCodeEditor(editor, editorElement) {
  var lineHeight = editor.renderer.lineHeight || 22;
  var lines = editor.session.getLength();
  var height = Math.min(Math.max(lines * lineHeight + 72, 360), 720);
  editorElement.style.height = height + 'px';
  editor.resize();
}

// ══════════════════════════════════════════════════════════════════
//  ACE READ-ONLY VIEWERS (code blocks — syntax highlighting)
// ══════════════════════════════════════════════════════════════════
(function initCodeViewers() {
  if (typeof ace === 'undefined') return;
  document.querySelectorAll('.lb-code-ace-view').forEach(function (edDiv) {
    var lang = edDiv.dataset.lang || 'csharp';
    // Read raw code from the hidden <pre class="lb-code-src">
    var srcPre = edDiv.nextElementSibling;
    var code   = srcPre ? srcPre.textContent : '';

    var editor = ace.edit(edDiv);
    editor.setTheme('ace/theme/tomorrow_night_bright');
    editor.session.setMode('ace/mode/' + lang);
    editor.setValue(code, -1);
    editor.setReadOnly(true);
    editor.setOptions({
      fontSize        : '13px',
      fontFamily      : "'Courier New', monospace",
      showPrintMargin : false,
      highlightActiveLine: false,
      showGutter      : false,
      maxLines        : Infinity,
      wrap            : false,
      useWorker       : false   // no web-worker needed for read-only display
    });
    editor.renderer.setShowGutter(false);
    editor.clearSelection();
    edDiv._aceEditor = editor; // для ресайза при расширении панели
    editor.renderer.setPadding(22);
    editor.renderer.setScrollMargin(20, 20);
    // Скрываем курсор и слой выделения у read-only вьюверов
    editor.renderer.$cursorLayer.element.style.display = 'none';
    editor.on('focus', function () { editor.blur(); }); // не даём фокусу появляться
  });
})();

function getEditorValue(block) {
  if (block._aceEditor) return block._aceEditor.getValue();
  var inp = block.querySelector('.lb-task-input');
  return inp ? inp.value : '';
}

/* Сброс кода к стартовому (data-starter на блоке) */
function resetCode(btn) {
  var block   = btn.closest('.lb');
  var starter = block.dataset.starter || '';

  if (block._aceEditor) {
    // Ace-редактор
    block._aceEditor.setValue(starter, -1);
    block._aceEditor.clearSelection();
    block._aceEditor.focus();
  } else {
    // Обычный textarea
    var inp = block.querySelector('.lb-task-input');
    if (inp) {
      inp.value = starter;
      autoGrowTextarea(inp);
      inp.focus();
    }
  }

  // Сбросить сообщение о результате
  var result = block.querySelector('.lb-task-result');
  if (result) { result.textContent = ''; result.style.whiteSpace = ''; }

  // Сброс счётчика локальных ошибок и подсказки
  block._localErrors = 0;
  var hintEl = block.querySelector('.lb-task-hint');
  if (hintEl) hintEl.classList.remove('lb-hint--show');
}

function autoGrowTextarea(textarea) {
  if (!textarea || textarea.style.display === 'none') return;
  textarea.style.height = 'auto';
  textarea.style.height = Math.min(Math.max(textarea.scrollHeight + 4, 170), 520) + 'px';
}

(function initAnswerTextareas() {
  document.querySelectorAll('.lb-task-input:not(.lb-challenge-editor)').forEach(function (textarea) {
    if (textarea.closest('.lb[data-run]')) return;
    textarea.classList.add('lb-answer-input');
    autoGrowTextarea(textarea);
    textarea.addEventListener('input', function () { autoGrowTextarea(textarea); });
    textarea.addEventListener('focus', function () { autoGrowTextarea(textarea); });
  });
})();

async function runCodeInternal(code, lang, block) {
  var panel   = block.querySelector('.lb-output');
  var content = panel && panel.querySelector('.lb-output-content');
  var msEl    = panel && panel.querySelector('.lb-output-ms');
  if (panel) {
    panel.style.display = '';
    panel.className = 'lb-output lb-output--running';
    if (content) content.textContent = 'Выполняется...';
    if (msEl)    msEl.textContent    = '';
  }
  try {
    var resp = await fetch('/api/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code, language: lang })
    });
    var data = await resp.json();
    if (panel) {
      panel.className = 'lb-output ' + (data.success ? 'lb-output--ok' : 'lb-output--error');
      if (content) content.textContent = data.success
        ? (data.output || '(нет вывода)')
        : (data.error  || 'Неизвестная ошибка');
      if (msEl && data.ms) msEl.textContent = data.ms + ' ms';
    }
    return data;
  } catch (e) {
    if (panel) {
      panel.className = 'lb-output lb-output--error';
      if (content) content.textContent = 'Ошибка соединения';
    }
    return { success: false, output: '', error: 'Network error', ms: 0 };
  }
}

async function runCode(btn) {
  var block = btn.closest('.lb');
  var lang  = (block.dataset.language || '').trim();
  if (!lang) return;
  btn.disabled = true; btn.textContent = '...';
  await runCodeInternal(getEditorValue(block), lang, block);
  btn.disabled = false; btn.innerHTML = '&#9654; Запустить';
}

