@model CodeLearn.Models.MainViewModel

@section FullPage {

    <div class="main-container">
        <div class="screen-main">

            <!-- ======================
                 ФОН КАРТЫ
            ======================= -->
            <div class="background">
                <img class="bg-map" src="/img/main/background/bg-map.png">
                <img class="swords" src="/img/main/decor/swords.png">
            </div>

            <!-- ======================
                 ДЕКОР КАРТЫ
            ======================= -->
            <img class="mountain-left" src="/img/main/decor/mountain.svg">
            <img class="mountain-right" src="/img/main/decor/mountain.svg">
            <img class="castle castle-1" src="/img/main/decor/castle.svg">
            <img class="castle castle-2" src="/img/main/decor/castle.svg">

            <!-- ======================
                 КАРТА УРОВНЕЙ
            ======================= -->
            <div class="levels-main">
                <img class="levels-bg" src="/img/main/levels/levels-background.svg">

                <div class="levels-map">
                    @{
                        var ic = System.Globalization.CultureInfo.InvariantCulture;
                    }
                    @{
                        var unlockedModuleIds   = ViewBag.UnlockedModuleIds   as HashSet<int> ?? new HashSet<int>();
                        var completedModuleIds  = ViewBag.CompletedModuleIds  as HashSet<int> ?? new HashSet<int>();
                        var nextModuleId        = (int)(ViewBag.NextModuleId ?? 0);
                    }
                    @foreach (var module in Model.Modules)
                    {
                        var posStyle = $"left:{module.MapX.ToString("F1", ic)}%;top:{module.MapY.ToString("F1", ic)}%;--node-color:{module.Color};--label-size:{module.LabelFontSize}px";
                        var isChallenge = module.IsChallenge;
                        var isUnlocked  = unlockedModuleIds.Contains(module.Id);
                        var isCompleted = completedModuleIds.Contains(module.Id);
                        var stateCls    = (isCompleted ? " level--done" : "") + (module.Id == nextModuleId ? " level--next" : "");
                        var dataAttrs   = $"data-mid=\"{module.Id}\" data-completed=\"{(isCompleted ? "1" : "0")}\"";

                        @* ── Пиксельная звезда-трофей (для контрольных задач) ── *@
                        @* Используется вместо папки *@

                        if (isChallenge && isUnlocked)
                        {
                            <a asp-controller="Course" asp-action="Index" asp-route-id="@module.Id"
                               class="level level-challenge@(stateCls)" style="@posStyle" data-mid="@module.Id" data-completed="@(isCompleted ? "1" : "0")" title="@module.Title.StripEmoji() — Контрольная задача">
                                <div class="pixel-challenge-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" shape-rendering="crispEdges" fill="none">
                                        <!-- Кубок: ножка -->
                                        <rect class="ch-base"  x="18" y="42" width="12" height="4"/>
                                        <rect class="ch-base"  x="14" y="40" width="20" height="2"/>
                                        <!-- Кубок: тело -->
                                        <rect class="ch-body"  x="10" y="16" width="28" height="22"/>
                                        <rect class="ch-dark"  x="12" y="18" width="24" height="18"/>
                                        <rect class="ch-shine" x="12" y="18" width="4"  height="18"/>
                                        <rect class="ch-shine" x="12" y="18" width="24" height="3"/>
                                        <!-- Кубок: ручки -->
                                        <rect class="ch-body"  x="6"  y="18" width="4"  height="12"/>
                                        <rect class="ch-body"  x="38" y="18" width="4"  height="12"/>
                                        <rect class="ch-dark"  x="8"  y="20" width="2"  height="8"/>
                                        <rect class="ch-dark"  x="38" y="20" width="2"  height="8"/>
                                        <!-- Кубок: верхний край -->
                                        <rect class="ch-base"  x="8"  y="14" width="32" height="2"/>
                                        <!-- Звезда внутри -->
                                        <rect class="ch-star"  x="22" y="22" width="4"  height="4"/>
                                        <rect class="ch-star"  x="20" y="24" width="8"  height="2"/>
                                        <rect class="ch-star"  x="18" y="26" width="12" height="2"/>
                                        <rect class="ch-star"  x="20" y="28" width="8"  height="2"/>
                                        <rect class="ch-star"  x="22" y="30" width="4"  height="2"/>
                                        <!-- Блик -->
                                        <rect class="ch-glow"  x="14" y="20" width="2"  height="6"/>
                                    </svg>
                                    <span class="pixel-challenge-label">@module.Title.StripEmoji()</span>
                                    <span class="pixel-challenge-badge">ИСПЫТАНИЕ</span>
                                    @if (completedModuleIds.Contains(module.Id))
                                    {
                                        <div class="folder-done-badge">
                                            <svg viewBox="0 0 18 15" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
                                                <rect x="0"  y="9"  width="3" height="3" fill="#00e676"/>
                                                <rect x="3"  y="12" width="3" height="3" fill="#00e676"/>
                                                <rect x="6"  y="9"  width="3" height="3" fill="#00e676"/>
                                                <rect x="9"  y="6"  width="3" height="3" fill="#00e676"/>
                                                <rect x="12" y="3"  width="3" height="3" fill="#00e676"/>
                                                <rect x="15" y="0"  width="3" height="3" fill="#00e676"/>
                                            </svg>
                                        </div>
                                    }
                                </div>
                            </a>
                        }
                        else if (isChallenge && !isUnlocked)
                        {
                            <div class="level level-challenge level-locked" style="@posStyle" @Html.Raw(dataAttrs) title="@module.Title.StripEmoji() — Заблокировано">
                                <div class="pixel-challenge-icon pixel-challenge-icon--locked">
                                    <div class="folder-lock-badge"><svg viewBox="0 0 12 14" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges"><rect x="3" y="0" width="6" height="2" fill="#9a9a9a"/><rect x="2" y="2" width="2" height="4" fill="#9a9a9a"/><rect x="8" y="2" width="2" height="4" fill="#9a9a9a"/><rect x="1" y="6" width="10" height="8" fill="#c8c8c8"/><rect x="5" y="9" width="2" height="3" fill="#333"/></svg></div>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" shape-rendering="crispEdges" fill="none">
                                        <rect class="ch-base"  x="18" y="42" width="12" height="4"/>
                                        <rect class="ch-base"  x="14" y="40" width="20" height="2"/>
                                        <rect class="ch-body"  x="10" y="16" width="28" height="22"/>
                                        <rect class="ch-dark"  x="12" y="18" width="24" height="18"/>
                                        <rect class="ch-body"  x="6"  y="18" width="4"  height="12"/>
                                        <rect class="ch-body"  x="38" y="18" width="4"  height="12"/>
                                        <rect class="ch-base"  x="8"  y="14" width="32" height="2"/>
                                        <!-- Замок вместо звезды -->
                                        <rect class="ch-star"  x="20" y="26" width="8"  height="8"/>
                                        <rect class="ch-dark"  x="22" y="28" width="4"  height="4"/>
                                        <rect class="ch-star"  x="22" y="22" width="4"  height="6"/>
                                    </svg>
                                    <span class="pixel-challenge-label">@module.Title.StripEmoji()</span>
                                    <span class="pixel-challenge-badge">ИСПЫТАНИЕ</span>
                                </div>
                            </div>
                        }
                        else if (isUnlocked)
                        {
                            <a asp-controller="Course" asp-action="Index" asp-route-id="@module.Id"
                               class="level@(stateCls)" style="@posStyle" data-mid="@module.Id" data-completed="@(isCompleted ? "1" : "0")" title="@module.Title.StripEmoji()">
                                <div class="pixel-folder">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 40" shape-rendering="crispEdges" fill="none">
                                        <rect class="f-tab"    x="2"  y="2"  width="14" height="4"/>
                                        <rect class="f-tab"    x="16" y="4"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="2"  y="6"  width="44" height="30"/>
                                        <rect class="f-dark"   x="4"  y="8"  width="40" height="26"/>
                                        <rect class="f-body"   x="4"  y="8"  width="40" height="26"/>
                                        <rect class="f-shine"  x="4"  y="8"  width="40" height="3"/>
                                        <rect class="f-shine"  x="4"  y="11" width="2"  height="23"/>
                                        <rect class="f-edge"   x="4"  y="8"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="42" y="8"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="4"  y="32" width="2"  height="2"/>
                                        <rect class="f-edge"   x="42" y="32" width="2"  height="2"/>
                                        <rect class="f-shadow" x="4"  y="33" width="40" height="2"/>
                                        <rect class="f-shadow" x="43" y="9"  width="2"  height="24"/>
                                        <rect class="f-edge"   x="22" y="20" width="4"  height="2"/>
                                        <rect class="f-edge"   x="21" y="22" width="6"  height="3"/>
                                    </svg>
                                    <span class="pixel-folder-label">@module.Title.StripEmoji()</span>
                                    @if (completedModuleIds.Contains(module.Id))
                                    {
                                        <div class="folder-done-badge">
                                            <svg viewBox="0 0 18 15" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
                                                <rect x="0"  y="9"  width="3" height="3" fill="#00e676"/>
                                                <rect x="3"  y="12" width="3" height="3" fill="#00e676"/>
                                                <rect x="6"  y="9"  width="3" height="3" fill="#00e676"/>
                                                <rect x="9"  y="6"  width="3" height="3" fill="#00e676"/>
                                                <rect x="12" y="3"  width="3" height="3" fill="#00e676"/>
                                                <rect x="15" y="0"  width="3" height="3" fill="#00e676"/>
                                            </svg>
                                        </div>
                                    }
                                </div>
                                <span>@module.Title.StripEmoji()</span>
                            </a>
                        }
                        else
                        {
                            <div class="level level-locked" style="@posStyle" @Html.Raw(dataAttrs) title="Заблокировано">
                                <div class="pixel-folder">
                                    <div class="folder-lock-badge"><svg viewBox="0 0 12 14" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges"><rect x="3" y="0" width="6" height="2" fill="#9a9a9a"/><rect x="2" y="2" width="2" height="4" fill="#9a9a9a"/><rect x="8" y="2" width="2" height="4" fill="#9a9a9a"/><rect x="1" y="6" width="10" height="8" fill="#c8c8c8"/><rect x="5" y="9" width="2" height="3" fill="#333"/></svg></div>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 40" shape-rendering="crispEdges" fill="none">
                                        <rect class="f-tab"    x="2"  y="2"  width="14" height="4"/>
                                        <rect class="f-tab"    x="16" y="4"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="2"  y="6"  width="44" height="30"/>
                                        <rect class="f-dark"   x="4"  y="8"  width="40" height="26"/>
                                        <rect class="f-body"   x="4"  y="8"  width="40" height="26"/>
                                        <rect class="f-shine"  x="4"  y="8"  width="40" height="3"/>
                                        <rect class="f-shine"  x="4"  y="11" width="2"  height="23"/>
                                        <rect class="f-edge"   x="4"  y="8"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="42" y="8"  width="2"  height="2"/>
                                        <rect class="f-edge"   x="4"  y="32" width="2"  height="2"/>
                                        <rect class="f-edge"   x="42" y="32" width="2"  height="2"/>
                                        <rect class="f-shadow" x="4"  y="33" width="40" height="2"/>
                                        <rect class="f-shadow" x="43" y="9"  width="2"  height="24"/>
                                        <rect class="f-edge"   x="22" y="20" width="4"  height="2"/>
                                        <rect class="f-edge"   x="21" y="22" width="6"  height="3"/>
                                    </svg>
                                    <span class="pixel-folder-label">@module.Title.StripEmoji()</span>
                                </div>
                                <span>@module.Title.StripEmoji()</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- ======================
                 ДИНАМИЧЕСКИЕ ОБЪЕКТЫ
            ======================= -->
            <div id="objects"></div>

            <!-- ======================
                 ЭФФЕКТЫ
            ====================== -->
            <div id="binaryClouds"></div>
            <div id="stars" data-theme="@ViewBag.CourseId"></div>

            <svg width="0" height="0">
                <filter id="fog-warp">
                    <feTurbulence type="fractalNoise"
                                  baseFrequency="0.01 0.02"
                                  numOctaves="2"
                                  seed="2"
                                  result="noise" />
                    <feDisplacementMap in="SourceGraphic"
                                       in2="noise"
                                       scale="60"
                                       xChannelSelector="R"
                                       yChannelSelector="G" />
                </filter>
            </svg>

            <img src="/img/main/background/fog.png" class="fog">

        </div>
    </div>

    <!-- ======================
         HUD ПОЛЬЗОВАТЕЛЯ (пиксельный)
    ======================= -->
    <div class="user-widget">
        <a class="course-switch" asp-controller="Courses" asp-action="Index">
            <span>курс</span>
            <b>@(ViewBag.CourseTitle ?? "C# / .NET")</b>
        </a>
        <img class="user-widget-avatar"
             src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/img/main/ui/default-avatar.png" : Model.AvatarUrl)"
             alt="avatar">
        <div class="user-widget-body">
            <span class="user-widget-nick">@Model.NickName.ToUpper()</span>
            <div class="user-widget-stats">
                <div class="user-stat">
                    <span class="stat-val">@Model.Streak</span>
                    <span class="stat-lbl">серия</span>
                </div>
                <div class="stat-sep"></div>
                <div class="user-stat">
                    <span class="stat-val">@Model.TotalDays</span>
                    <span class="stat-lbl">дней</span>
                </div>
                <div class="stat-sep"></div>
                <div class="user-stat">
                    <span class="stat-val">@Model.CurrentModule</span>
                    <span class="stat-lbl">модуль</span>
                </div>
                <div class="stat-sep"></div>
                <div class="user-stat">
                    <span class="stat-val @(Model.TotalErrors > 0 ? "err-val" : "")">@Model.TotalErrors</span>
                    <span class="stat-lbl">ошибок</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================
         БИБЛИОТЕКИ
    ======================= -->
    <script id="map-modules-data" type="application/json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Modules
                .OrderBy(m => m.Order)
                .Select(m => new
                {
                    id = m.Id,
                    order = m.Order,
                    title = m.Title.StripEmoji(),
                    x = m.MapX,
                    y = m.MapY,
                    color = m.Color,
                    isUnlocked  = !m.IsLocked,
                    isChallenge = m.IsChallenge
                })
        ))
    </script>
    <script src="~/lib/perlin.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/animejs/lib/anime.min.js"></script>

    <!-- ======================
         SPAWN ОБЪЕКТОВ
    ======================= -->
    <script src="~/js/main/spawners/spawnObject.js" asp-append-version="true"></script>
    <script src="~/js/main/spawners/_TreeSpawner.js" asp-append-version="true"></script>
    <script src="~/js/main/spawners/_FlagSpawner.js" asp-append-version="true"></script>

    <!-- ======================
         АНИМАЦИИ
    ======================= -->
    <script src="~/js/main/animations/levels-animation.js" asp-append-version="true"></script>
    <script src="~/js/main/map-paths.js" asp-append-version="true"></script>
    <script src="~/js/main/animations/cloud-animation.js" asp-append-version="true"></script>

    <!-- ======================
         ЭФФЕКТЫ
    ======================= -->
    <script src="~/js/main/effects/perlinField.js" asp-append-version="true"></script>
    <script src="~/js/main/effects/binaryRain.js" asp-append-version="true"></script>
    <script src="~/js/main/effects/fogPerlin.js" asp-append-version="true"></script>
    <script src="~/js/main/effects/starPerlin.js" asp-append-version="true"></script>
    <script src="~/js/main/effects/parallaxEffect.js" asp-append-version="true"></script>

    <!-- ======================
         ЛОГИКА СЦЕНЫ
    ======================= -->
    <script src="~/js/main/logic/LockPanel.js" asp-append-version="true"></script>
    <script src="~/js/main/logic/start-position.js" asp-append-version="true"></script>

    <script>window.__mapCourseId = @(ViewBag.CourseDbId ?? 0);</script>
    <script src="~/js/main/map-objects.js" asp-append-version="true"></script>

    <!-- ======================
         ВЫДВИЖНАЯ ПАНЕЛЬ (пиксельная)
    ======================= -->
    <div class="slide-panel" id="slidePanel">

        <!-- Ручка -->
        <div class="slide-handle" id="slideHandle">
            <div class="slide-bar"></div>
        </div>

        <!-- Контент -->
        <div class="slide-content">

            <!-- Профиль -->
            <div class="sp-profile">
                <img class="sp-avatar"
                     src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/img/main/ui/default-avatar.png" : Model.AvatarUrl)"
                     alt="avatar">
                <div class="sp-nick">@Model.NickName.ToUpper()</div>
                <div class="sp-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
            </div>

            <!-- Статистика -->
            <div class="sp-section">
                <div class="sp-section-title">Статистика</div>
                <div class="sp-stats">
                    <div class="sp-stat">
                        <div class="sp-stat-val">@Model.Streak</div>
                        <div class="sp-stat-lbl">Серия</div>
                    </div>
                    <div class="sp-stat">
                        <div class="sp-stat-val">@Model.TotalDays</div>
                        <div class="sp-stat-lbl">Дней</div>
                    </div>
                    <div class="sp-stat">
                        <div class="sp-stat-val">@Model.CurrentModule</div>
                        <div class="sp-stat-lbl">Модуль</div>
                    </div>
                </div>
            </div>

            <!-- Выбор курса -->
            <a asp-controller="Courses" asp-action="Index" class="sp-nav-btn">Выбрать курс</a>

            <!-- Выход -->
            <form asp-action="Logout" asp-controller="Account" method="post">
                <button type="submit" class="sp-logout">Выйти из аккаунта</button>
            </form>

        </div>
    </div>

    <script>
    (function () {
        const panel  = document.getElementById('slidePanel');
        const handle = document.getElementById('slideHandle');
        const COLLAPSED = 44;
        const EXPANDED  = Math.round(window.innerHeight * 0.72);

        let dragging = false, startY = 0, startH = 0;

        function setH(h, animate) {
            panel.style.transition = animate ? 'height .35s steps(12)' : 'none';
            panel.style.height = h + 'px';
            handle.dataset.open = (h > COLLAPSED + 10) ? 'true' : 'false';
        }

        handle.addEventListener('touchstart', e => {
            dragging = true;
            startY = e.touches[0].clientY;
            startH = panel.offsetHeight;
            panel.style.transition = 'none';
        }, { passive: true });

        document.addEventListener('touchmove', e => {
            if (!dragging) return;
            const dy = startY - e.touches[0].clientY;
            const h  = Math.max(COLLAPSED, Math.min(EXPANDED, startH + dy));
            panel.style.height = h + 'px';
        }, { passive: true });

        document.addEventListener('touchend', () => {
            if (!dragging) return;
            dragging = false;
            const h = panel.offsetHeight;
            setH(h > window.innerHeight * 0.22 ? EXPANDED : COLLAPSED, true);
        });

        handle.addEventListener('click', () => {
            const open = panel.offsetHeight > COLLAPSED + 10;
            setH(open ? COLLAPSED : EXPANDED, true);
        });

        setH(COLLAPSED, false);
    })();
    </script>

    <script>
    /* ── Эффект «раскола» только что завершённого модуля ──
       Срабатывает один раз: если модуль помечен completed, но ещё не «виден»
       в localStorage — проигрываем анимацию + рассыпаем пиксельные осколки. */
    (function () {
        const KEY = 'seenCompletedModules';
        let seen;
        try { seen = new Set(JSON.parse(localStorage.getItem(KEY) || '[]').map(Number)); }
        catch { seen = new Set(); }

        const done = Array.from(document.querySelectorAll('.level[data-completed="1"]'));
        const fresh = done.filter(el => !seen.has(Number(el.dataset.mid)));

        function spawnShards(el) {
            const icon = el.querySelector('.pixel-folder, .pixel-challenge-icon');
            if (!icon) return;
            const host = getComputedStyle(el).position === 'static' ? el : el;
            const color = (getComputedStyle(el).getPropertyValue('--node-color') || '#fff').trim() || '#fff';
            const N = 14;
            for (let i = 0; i < N; i++) {
                const p = document.createElement('div');
                p.className = 'shatter-piece';
                const sz = 4 + Math.floor(Math.random() * 6);
                p.style.width = p.style.height = sz + 'px';
                p.style.background = color;
                p.style.boxShadow = '0 0 4px ' + color;
                el.appendChild(p);

                const ang = (Math.PI * 2 * i) / N + (Math.random() - 0.5);
                const dist = 40 + Math.random() * 70;
                const dx = Math.cos(ang) * dist;
                const dy = Math.sin(ang) * dist - 20;
                const rot = (Math.random() - 0.5) * 540;

                p.animate([
                    { transform: 'translate(-50%,-50%) translate(0,0) rotate(0deg)',           opacity: 1 },
                    { transform: `translate(-50%,-50%) translate(${dx}px,${dy + 60}px) rotate(${rot}deg)`, opacity: 0 }
                ], {
                    duration: 650 + Math.random() * 350,
                    easing: 'cubic-bezier(.25,.7,.4,1)',
                    fill: 'forwards'
                }).onfinish = () => p.remove();
            }
        }

        fresh.forEach((el, idx) => {
            setTimeout(() => {
                el.classList.add('level--shatter');
                spawnShards(el);
            }, 300 + idx * 250);
        });

        // Запоминаем все пройденные как «виденные»
        const all = done.map(el => Number(el.dataset.mid));
        try { localStorage.setItem(KEY, JSON.stringify(Array.from(new Set(all)))); } catch {}
    })();
    </script>

}
